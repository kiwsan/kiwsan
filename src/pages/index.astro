---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Metrics from '../components/Metrics.astro';
import Projects from '../components/Projects.astro';
import WorkExperience from '../components/WorkExperience.astro';
import TechStack from '../components/TechStack.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { buildProfileSchema } from '../lib/seo';

const currentWork = (await getCollection('projects'))
  .filter((project) => project.data.type === 'work')
  .sort((a, b) => a.data.order - b.data.order)[0];

const structuredData = currentWork
  ? buildProfileSchema({ role: currentWork.data.title, company: currentWork.data.company })
  : null;
---

<Layout structuredData={structuredData}>
  <Header />
  <main id="main-content" role="main">
    <Hero />
    <Metrics />
    <section aria-label="Professional Experience">
      <WorkExperience />
    </section>
    <section aria-label="Featured Projects">
      <Projects />
    </section>
    <section aria-label="Technical Skills">
      <TechStack />
    </section>
    <section aria-label="Contact Information">
      <Contact />
    </section>
  </main>
  <Footer />
</Layout>
