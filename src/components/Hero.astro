---
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <span class="hero-label">
          AI Manager &middot; Full Stack Engineer &mdash; Bangkok, Thailand
        </span>
        <h1>
          I build systems <br />
          that process <br />
          <span class="highlight">Million+ orders</span>
        </h1>
        <div class="hero-rule"></div>
        <p class="hero-description">
          AI Manager at MC Group, building the LLM gateway and agent tooling behind a million-plus
          orders a year. 10+ years across e-commerce integration, cloud architecture, and full-stack
          engineering.
        </p>
        <div class="tags">
          <span>AI Platform</span>
          <span>E-commerce Integration</span>
          <span>Cloud Architecture</span>
          <span>React &bull; TypeScript &bull; AWS</span>
        </div>
        <div class="cta">
          <a href="#experience" class="btn-primary">
            View My Work
          </a>
          <a href="#contact" class="btn-secondary">
            Get in Touch
          </a>
        </div>
      </div>

      <div class="hero-illustration">
        <!-- Inlined so the drawing reads the theme tokens directly; the old
             <img> needed an invert() filter to survive dark mode. The line
             language matches the blueprint desks in #experience. -->
        <svg
          class="hero-figure"
          viewBox="420 40 720 380"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label="Ekkachai at a desk, connected to a network"
        >
          <defs>
            <pattern id="hero-bp-grid" width="12" height="12" patternUnits="userSpaceOnUse">
              <circle class="hi-grid-dot" cx="1" cy="1" r="0.9" />
            </pattern>
          </defs>

          <!-- plotting grid behind the mesh -->
          <rect
            class="hi-grid"
            x="724"
            y="54"
            width="348"
            height="248"
            rx="6"
            fill="url(#hero-bp-grid)"
          />

          <!-- construction mesh -->
          <g class="hi-mesh">
            <path d="M760 110 L900 70 L1050 160 L930 270 L770 210 Z" />
            <path d="M900 70 L930 270" />
            <path d="M760 110 L1050 160" />
          </g>

          <!-- node crosshairs -->
          <g class="hi-cross">
            <path d="M754 110 L766 110 M760 104 L760 116" />
            <path d="M894 70 L906 70 M900 64 L900 76" />
            <path d="M1044 160 L1056 160 M1050 154 L1050 166" />
            <path d="M924 270 L936 270 M930 264 L930 276" />
            <path d="M764 210 L776 210 M770 204 L770 216" />
          </g>

          <!-- network nodes -->
          <circle class="hi-node" cx="760" cy="110" r="4.5" />
          <circle class="hi-node" cx="900" cy="70" r="4.5" />
          <circle class="hi-node" cx="1050" cy="160" r="4.5" />
          <circle class="hi-node" cx="930" cy="270" r="4.5" />
          <circle class="hi-node" cx="770" cy="210" r="4.5" />

          <!-- leaders: the laptop ships to the floating panels -->
          <g class="hi-leader">
            <path d="M690 302 L846 322" />
            <path d="M690 268 L956 242" />
            <path d="M690 330 L1026 319" />
          </g>
          <circle class="hi-leader-dot" cx="846" cy="322" r="2.5" />
          <circle class="hi-leader-dot" cx="956" cy="242" r="2.5" />
          <circle class="hi-leader-dot" cx="1026" cy="319" r="2.5" />

          <!-- desk + dimension -->
          <rect class="hi-panel" x="470" y="340" width="260" height="8" rx="4" />
          <path class="hi-dim" d="M470 366 L730 366 M470 361 L470 371 M730 361 L730 371" />

          <!-- laptop -->
          <path
            class="hi-main"
            d="M540 260 h130 a10 10 0 0 1 10 10 v60 a10 10 0 0 1 -10 10 h-130 a10 10 0 0 1 -10 -10 v-60 a10 10 0 0 1 10 -10 Z"
          />
          <rect class="hi-panel" x="520" y="340" width="170" height="8" rx="4" />

          <!-- code symbol -->
          <polyline class="hi-main" points="565,300 545,315 565,330" />
          <polyline class="hi-main" points="645,300 665,315 645,330" />

          <!-- developer -->
          <path class="hi-main" d="M588 215 a22 22 0 1 0 44 0 a22 22 0 1 0 -44 0" />
          <path class="hi-main" d="M570 255 c15 -32 80 -32 90 0" />
          <path class="hi-main" d="M575 255 L545 305" />
          <path class="hi-main" d="M645 255 L675 305" />

          <!-- floating panels -->
          <g>
            <rect class="hi-panel" x="850" y="300" width="80" height="44" rx="10" />
            <path class="hi-panel-line" d="M865 320 L915 320 M865 330 L900 330" />
          </g>
          <g>
            <rect class="hi-panel" x="960" y="220" width="80" height="44" rx="10" />
            <path class="hi-panel-line" d="M975 240 L1025 240 M975 250 L1010 250" />
          </g>
          <g>
            <rect class="hi-panel" x="1030" y="300" width="70" height="38" rx="10" />
            <path class="hi-panel-line" d="M1045 318 L1080 318" />
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(4rem, 8vw, 6rem) 0;
    overflow: hidden;
  }

  .hero-content {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-16);
    align-items: center;
  }

  .hero-text {
    min-width: 0;
  }

  .hero-label {
    display: block;
    margin-bottom: var(--space-4);
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-ink-muted);
  }

  h1 {
    margin-bottom: var(--space-5);
    font-size: var(--text-title);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  h1 br {
    display: none;
  }

  .highlight {
    color: var(--color-ink);
  }

  .hero-rule {
    width: 48px;
    height: 1px;
    margin-bottom: var(--space-5);
    background: var(--color-ink);
  }

  .hero-description {
    max-width: 62ch;
    margin-bottom: var(--space-6);
    font-size: var(--text-lede);
    line-height: 1.55;
    color: var(--color-ink);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .tags span {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-inline);
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-control);
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out);
  }

  .btn-primary {
    background: var(--color-ink);
    color: var(--color-page);
    border: 1px solid var(--color-ink);
  }

  .btn-primary:hover {
    background: var(--color-page);
    color: var(--color-ink);
  }

  .btn-primary:active {
    background: var(--color-page);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  .btn-secondary {
    background: var(--color-page);
    color: var(--color-ink);
    border: 1px solid var(--color-ink);
  }

  .btn-secondary:hover {
    background: var(--color-ink);
    color: var(--color-page);
  }

  .btn-secondary:active {
    background: var(--color-ink);
    color: var(--color-page);
    box-shadow: inset 0 0 0 1px var(--color-page);
  }

  .hero-illustration {
    display: flex;
    justify-content: center;
    align-items: center;
    min-width: 0;
    padding: clamp(1rem, 2vw, 1.75rem);
    background: var(--color-plate);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-surface);
  }

  .hero-figure {
    display: block;
    width: 100%;
    max-width: 380px;
    height: auto;
    aspect-ratio: 720 / 380;
  }

  /* The portrait draws in ink and rule only; no accent, glow, or motion. */
  .hi-main {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hi-mesh path {
    fill: none;
    stroke: var(--color-ink-muted);
    stroke-width: 1.3;
    stroke-dasharray: 4 6;
    opacity: 0.4;
  }

  .hi-cross path {
    fill: none;
    stroke: var(--color-ink-muted);
    stroke-width: 1;
    opacity: 0.4;
  }

  .hi-node {
    fill: var(--color-ink);
  }

  .hi-leader path {
    fill: none;
    stroke: var(--color-ink-muted);
    stroke-width: 1.2;
    stroke-dasharray: 2 5;
    opacity: 0.45;
  }

  .hi-leader-dot {
    fill: var(--color-ink-muted);
  }

  .hi-grid-dot {
    fill: color-mix(in srgb, var(--color-ink) 20%, transparent);
  }

  .hi-panel {
    fill: var(--color-plate);
    stroke: var(--color-rule);
    stroke-width: 1;
  }

  .hi-panel-line {
    fill: none;
    stroke: var(--color-ink-muted);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .hi-dim {
    fill: none;
    stroke: var(--color-rule);
    stroke-width: 1;
  }

  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: minmax(0, 6fr) minmax(0, 4fr);
      gap: var(--space-10);
    }

    .hero-figure {
      max-width: 340px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: clamp(3rem, 9vw, 4rem) 0;
    }

    .hero-content {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .hero-figure {
      max-width: 320px;
      margin: 0 auto;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: clamp(2.5rem, 10vw, 3.5rem) 0;
    }

    .cta {
      flex-direction: column;
    }

    .cta a {
      width: 100%;
    }
  }
</style>
