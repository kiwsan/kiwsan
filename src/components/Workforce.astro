---
import { workforceFunctions, workforceHub } from '../data/workforce';
import { buildWorkforceScene } from '../lib/experience/workforce';

const scene = buildWorkforceScene();
const gates = ['scope', 'design', 'merge', 'deploy'];
---

<section id="workforce" class="workforce" aria-labelledby="workforce-title">
  <div class="container">
    <div class="workforce-head">
      <span class="section-label">How I work</span>
      <h2 id="workforce-title">One person. A 25-role AI team.</h2>
      <p class="workforce-caption">
        The team works in parallel and hands off real work: plans, code, tests and docs. Automated
        checks and specialist reviewers test it. I decide what to build and approve four
        checkpoints: scope, design, merge and deploy.
      </p>
      <a class="workforce-link" href="/workforce/">
        Read the case study
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="workforce-stage">
      <div class="floor-wrap">
        <svg
          class="floor"
          viewBox={scene.viewBox}
          role="img"
          aria-labelledby="workforce-svg-title workforce-svg-desc"
        >
          <title id="workforce-svg-title">The AI workforce floor</title>
          <desc id="workforce-svg-desc">
            A central chief-of-staff hub connected to six team pods: Product and Engineering,
            Prototype, Research, Marketing, Support and Security. One agent stands for each team;
            the count shows its roles.
          </desc>

          <defs>
            <pattern id="workforce-grid" width="24" height="24" patternUnits="userSpaceOnUse">
              <circle class="grid-dot" cx="1" cy="1" r="0.9" />
            </pattern>

            <!-- Base agent head, centred on 0,0. Every pod reuses it and adds
                 one role badge; the hub uses it plain. -->
            <g id="agent-head">
              <rect x="-25.5" y="-5.5" width="3.5" height="11" rx="1.75" fill="currentColor" />
              <rect x="22" y="-5.5" width="3.5" height="11" rx="1.75" fill="currentColor" />
              <path d="M0 -16 V-25" fill="none" stroke="currentColor" stroke-linecap="round" />
              <circle cx="0" cy="-27.5" r="2.6" fill="currentColor" />
              <rect
                x="-22"
                y="-16"
                width="44"
                height="32"
                rx="10"
                fill="currentColor"
                fill-opacity="0.14"
                stroke="currentColor"
                stroke-linejoin="round"
              />
              <circle cx="-8.5" cy="-2" r="3.7" fill="currentColor" />
              <circle cx="8.5" cy="-2" r="3.7" fill="currentColor" />
              <path d="M-7 7.5 H7" fill="none" stroke="currentColor" stroke-linecap="round" />
            </g>

            <!-- Role badges sit under the head, one per function. -->
            <g id="agent-badge-build" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="-6" y="22" width="12" height="12" rx="3" />
              <rect x="-2" y="26" width="4" height="4" rx="1" fill="currentColor" stroke="none" />
              <path d="M-3 22V19M3 22V19M-3 34V37M3 34V37M-6 26H-9M-6 30H-9M6 26H9M6 30H9" />
            </g>

            <g id="agent-badge-design">
              <path d="M-7 34 L5 22 L8 25 L-4 37 Z" fill="currentColor" />
              <path d="M-7 34 L-9 38 L-4 37 Z" fill="currentColor" />
              <path
                d="M3 24 L6 27"
                fill="none"
                stroke="var(--pod-top)"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </g>

            <g id="agent-badge-research">
              <circle
                cx="-2"
                cy="26"
                r="5.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
              />
              <path
                d="M2 30 L7 35"
                fill="none"
                stroke="currentColor"
                stroke-width="2.8"
                stroke-linecap="round"
              />
            </g>

            <g id="agent-badge-growth">
              <path d="M-7 26 H-4 L5 20 V32 L-4 30 H-7 Z" fill="currentColor" />
              <path d="M-4 30 V36 H0 V29" fill="currentColor" />
              <path
                d="M8 24 Q11 28 8 32"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </g>

            <g id="agent-badge-security">
              <path
                d="M0 20 L7 23 V29 C7 34 4 36.5 0 38 C-4 36.5 -7 34 -7 29 V23 Z"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linejoin="round"
              />
              <path
                d="M-3 28.5 L-1 31 L4 25.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </g>

            <!-- Support wears the headset instead of a badge. -->
            <g id="agent-headset">
              <path
                d="M-22 -1 A22 22 0 0 1 22 -1"
                fill="none"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
              />
              <rect x="-26" y="-3" width="5.5" height="14" rx="2.75" fill="currentColor" />
              <rect x="20.5" y="-3" width="5.5" height="14" rx="2.75" fill="currentColor" />
              <path
                d="M-23 11 Q-23 20 -13 21"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
              />
              <circle cx="-11.5" cy="21" r="2.2" fill="currentColor" />
            </g>
          </defs>

          <rect class="floor-grid" width="1000" height="640" fill="url(#workforce-grid)" />

          <g class="rails" aria-hidden="true">
            {scene.rails.map((rail) => (
              <path class="rail" d={rail.d} />
            ))}
          </g>

          <g class="hub">
            <circle class="hub-base" cx={scene.hub.cx} cy={scene.hub.cy} r={scene.hub.radius} />
            <circle
              class="hub-inner"
              cx={scene.hub.cx}
              cy={scene.hub.cy}
              r={scene.hub.radius - 9}
            />
            <g
              class="hub-agent"
              transform={`translate(${scene.hub.cx} ${scene.hub.cy}) scale(1.15)`}
              aria-hidden="true"
            >
              <use href="#agent-head" />
            </g>
            <text class="hub-name" x={scene.hub.cx} y={scene.hub.labelY} text-anchor="middle">
              {workforceHub.name}
            </text>
            <text class="hub-count" x={scene.hub.cx} y={scene.hub.labelY + 14} text-anchor="middle">
              planner · 1 role
            </text>
          </g>

          {scene.pods.map((pod, index) => (
            <g class:list={['pod', { 'is-active': index === 0 }]} data-pod={pod.id}>
              <path class="pod-left" d={pod.left} />
              <path class="pod-right" d={pod.right} />
              <path class="pod-top" d={pod.top} />
              <g class="pod-agent" transform={`translate(${pod.cx} ${pod.cy})`} aria-hidden="true">
                <use href="#agent-head" />
                {pod.icon === 'support' ? (
                  <use href="#agent-headset" />
                ) : (
                  <use href={`#agent-badge-${pod.icon}`} />
                )}
              </g>
              <text class="pod-name" x={pod.cx} y={pod.labelY} text-anchor="middle">
                {pod.label}
              </text>
              <text class="pod-count" x={pod.cx} y={pod.labelY + 14} text-anchor="middle">
                {pod.count} roles
              </text>
            </g>
          ))}
        </svg>
      </div>

      <aside class="shift-log" aria-labelledby="shift-log-title">
        <div class="log-head">
          <h3 id="shift-log-title">team status</h3>
        </div>

        <ul class="log-rows">
          {workforceFunctions.map((fn, index) => (
            <li class:list={['log-row', { 'is-active': index === 0 }]}>
              <span class="log-fn">{fn.label}</span>
              <span class="log-handoff">{fn.handoff}</span>
            </li>
          ))}
        </ul>

        <div class="log-legend">
          <span>
            <svg class="legend-agent" viewBox="-27 -31 54 48" aria-hidden="true">
              <use href="#agent-head" stroke-width="4" />
            </svg>
            agent = one team
          </span>
          <span>
            <i class="legend-rail"></i> rail = handoff
          </span>
          <span>
            <i class="legend-hub"></i> hub = planner
          </span>
        </div>

        <p class="log-principle">AI agents do the work · I approve what ships</p>

        <div class="log-gates">
          <span class="gate-label">my checkpoints</span>
          {gates.map((gate) => (
            <span class="gate">{gate}</span>
          ))}
        </div>
      </aside>
    </div>

    <div class="pod-cards" role="list" aria-label="Workforce functions">
      <article class="pod-card hub-card" role="listitem">
        <div class="pod-card-head">
          <h3>{workforceHub.label}</h3>
          <span class="pod-card-count">1 role</span>
        </div>
        <p class="pod-card-handoff">{workforceHub.name} → weekly plan · OKRs · handoffs</p>
        <p class="pod-card-roles">{workforceHub.owns}</p>
      </article>

      {workforceFunctions.map((fn) => (
        <article class="pod-card" role="listitem">
          <div class="pod-card-head">
            <h3>{fn.label}</h3>
            <span class="pod-card-count">{fn.roles.length} roles</span>
          </div>
          <p class="pod-card-handoff">{fn.handoff}</p>
          <p class="pod-card-roles">{fn.roles.map((role) => role.name).join(' · ')}</p>
        </article>
      ))}
    </div>

    <ul class="sr-only">
      <li>
        {workforceHub.label}: {workforceHub.name} — {workforceHub.owns}
      </li>
      {workforceFunctions.flatMap((fn) =>
        fn.roles.map((role) => (
          <li>
            {fn.label}: {role.name} — {role.owns}
          </li>
        ))
      )}
    </ul>
  </div>
</section>

<style>
  .workforce {
    padding: clamp(4rem, 8vw, 6rem) 0;
    border-top: 1px solid var(--color-rule);
  }

  .workforce-head {
    max-width: 68ch;
    margin-bottom: var(--space-8);
  }

  h2 {
    margin-bottom: var(--space-3);
    font-size: var(--text-section);
  }

  .workforce-caption {
    max-width: 62ch;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .workforce-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-small);
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .workforce-link:hover {
    color: var(--color-signal);
    text-decoration-thickness: 2px;
  }

  .workforce-link:active {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.1em;
  }

  .workforce-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: var(--space-6);
    align-items: start;
  }

  .floor-wrap {
    min-width: 0;
    padding: var(--space-4);
    background: var(--color-plate);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-surface);
  }

  .floor {
    display: block;
    width: 100%;
    height: auto;
  }

  .floor-grid {
    fill: url(#workforce-grid);
  }

  .grid-dot {
    fill: color-mix(in srgb, var(--color-ink) 14%, transparent);
  }

  .rail {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.2;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
    opacity: 0.4;
  }

  .hub-base {
    fill: var(--color-page);
    stroke: var(--color-ink);
    stroke-opacity: 0.35;
    stroke-width: 1;
  }

  .hub-inner {
    fill: none;
    stroke: var(--color-rule);
    stroke-width: 0.8;
    stroke-dasharray: 2 5;
  }

  .hub-agent {
    color: var(--color-ink);
  }

  .hub-name {
    fill: var(--color-ink);
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
  }

  .hub-count {
    fill: var(--color-ink-muted);
    font-family: var(--font-body);
    font-size: 18px;
  }

  .pod-top {
    fill: var(--color-page);
    stroke: var(--color-ink);
    stroke-opacity: 0.4;
    stroke-width: 0.8;
  }

  .pod-left {
    fill: var(--color-plate);
  }

  .pod-right {
    fill: color-mix(in srgb, var(--color-ink) 6%, var(--color-page));
  }

  .pod-agent {
    color: var(--color-ink);
  }

  .pod-name {
    fill: var(--color-ink);
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
  }

  .pod-count {
    fill: var(--color-ink-muted);
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
  }

  /* The current pod is the only use of signal in the drawing. */
  .pod.is-active .pod-top {
    stroke: var(--color-signal);
    stroke-opacity: 1;
  }

  .pod.is-active .pod-agent {
    color: var(--color-signal);
  }

  .pod.is-active .pod-name {
    fill: var(--color-signal);
  }

  .shift-log {
    min-width: 0;
    padding: var(--space-4);
    background: var(--color-page);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-surface);
  }

  .log-head {
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
  }

  .log-head h3 {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .log-rows {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .log-row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .log-row.is-active {
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-signal);
  }

  .log-fn {
    color: var(--color-ink);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .log-row.is-active .log-fn {
    color: var(--color-signal);
  }

  .log-handoff {
    color: var(--color-ink-muted);
    font-size: var(--text-small);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .log-legend {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-3);
    color: var(--color-ink-muted);
    font-size: var(--text-small);
  }

  .log-legend span {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .log-legend i {
    flex: none;
    width: 8px;
    height: 8px;
  }

  .legend-agent {
    width: 16px;
    height: 14px;
    color: var(--color-ink);
  }

  .legend-rail {
    height: 0;
    border-top: 1px dashed var(--color-ink-muted);
  }

  .legend-hub {
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-control);
  }

  .log-principle {
    margin-top: var(--space-4);
    color: var(--color-ink);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .log-gates {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }

  .gate-label {
    width: 100%;
    color: var(--color-ink-muted);
    font-size: var(--text-small);
  }

  .gate {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-inline);
    font-size: var(--text-small);
    color: var(--color-ink);
  }

  .pod-cards {
    display: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .pod-card {
    padding: var(--space-4);
    background: var(--color-page);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-surface);
  }

  .hub-card {
    grid-column: 1 / -1;
  }

  .pod-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .pod-card-head h3 {
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
  }

  .pod-card-count {
    flex: none;
    color: var(--color-ink-muted);
    font-size: var(--text-small);
  }

  .pod-card-handoff {
    margin: var(--space-2) 0 var(--space-1);
    color: var(--color-ink);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .pod-card-roles {
    color: var(--color-ink-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  @media (max-width: 1100px) {
    .workforce-stage {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 767px) {
    .workforce {
      padding: clamp(3rem, 9vw, 4rem) 0;
    }

    .workforce-stage {
      display: none;
    }

    .pod-cards {
      display: grid;
    }
  }

  @media (max-width: 560px) {
    .pod-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
