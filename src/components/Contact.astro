---
import { SITE } from '../lib/site';

const startYear = 2016;
const currentYear = new Date().getFullYear();
const yearsOfExperience = currentYear - startYear;
---

<section class="contact" id="contact">
  <div class="container contact-layout">
    <div class="contact-content">
      <span class="section-label">Contact</span>
      <h2>Let's Work Together</h2>
      <p class="intro">
        Bangkok, Thailand
        <br />
        {yearsOfExperience}+ years in software engineering
        <br />
        B.Sc. Information Technology
        <br />
        <a
          href="https://www.credly.com/badges/67952a92-1f24-469c-911a-b9f461552fdb"
          target="_blank"
          rel="noopener noreferrer"
          class="credential-link"
        >
          <img
            src="/images/programming_in_C_23-01.png"
            alt="Microsoft Certified C# Programming Badge"
            class="credential-icon"
            loading="lazy"
            decoding="async"
          />
          Microsoft Certified: Programming in C#
        </a>
      </p>
      <p class="focus">
        Currently: AI Manager @ MC Group
        <br />
        Focus: E-commerce integration, cloud architecture, AI-assisted development
      </p>
      <div class="links">
        <a href={`mailto:${SITE.email}`} class="link-item">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          {SITE.email}
        </a>
        <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="link-item">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
            <rect x="2" y="9" width="4" height="12" />
            <circle cx="4" cy="4" r="2" />
          </svg>
          linkedin.com/in/kiwsan
        </a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="link-item">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
          </svg>
          github.com/kiwsan
        </a>
      </div>
    </div>

    <aside class="contact-cta" aria-label="Direct contact">
      <span class="cta-label">Direct line</span>
      <p class="cta-text">
        Open to conversations about AI platforms, integration architecture, and engineering
        leadership.
      </p>
      <a class="cta-primary" href={`mailto:${SITE.email}?subject=Let%27s%20talk`}>
        Email me
      </a>
      <button class="cta-secondary" type="button" data-email={SITE.email} hidden>
        Copy email
      </button>
    </aside>
  </div>
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('.cta-secondary');
  if (copyButton) {
    copyButton.hidden = false;
    copyButton.addEventListener('click', async () => {
      const email = copyButton.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        copyButton.textContent = 'Copied';
        window.setTimeout(() => {
          copyButton.textContent = 'Copy email';
        }, 1600);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>

<style>
  .contact {
    padding: var(--space-16) 0;
    background: var(--color-surface-container-low);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    gap: var(--space-12);
    align-items: start;
  }

  .contact-content {
    max-width: 600px;
  }

  .contact-cta {
    position: sticky;
    top: 104px;
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: 0 16px 48px rgba(25, 28, 30, 0.06);
  }

  .cta-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .cta-text {
    font-size: var(--text-lg);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .cta-primary,
  .cta-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.875rem var(--space-5);
    border-radius: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.01em;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cta-primary {
    background: linear-gradient(135deg, #00288e, #1e40af);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 40, 142, 0.18);
    margin-bottom: var(--space-3);
  }

  .cta-primary:hover {
    background: linear-gradient(135deg, #003272, #00288e);
    color: #ffffff;
    text-decoration: none;
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0, 40, 142, 0.22);
  }

  .cta-secondary {
    border: none;
    background: var(--color-surface-container-high);
    color: var(--color-text);
    cursor: pointer;
  }

  .cta-secondary:hover {
    background: var(--color-secondary-container);
    color: var(--color-on-secondary-container);
    transform: translateY(-2px);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-8);
  }

  .intro {
    font-size: var(--text-base);
    line-height: 1.8;
    margin-bottom: var(--space-5);
  }

  .credential-link {
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .credential-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .credential-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }

  .focus {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    line-height: 1.8;
    font-size: var(--text-base);
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .link-item {
    font-size: var(--text-base);
    color: var(--color-text);
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    margin-left: calc(var(--space-4) * -1);
  }

  .link-item:hover {
    color: var(--color-primary);
    background: var(--color-bg);
    transform: translateX(4px);
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(25, 28, 30, 0.04);
  }

  .link-item svg {
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: var(--color-primary);
  }

  .link-item:hover svg {
    transform: scale(1.15);
  }

  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .contact-cta {
      position: static;
      padding: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .contact {
      padding: var(--space-12) 0;
    }
    h2 {
      font-size: var(--text-3xl);
    }
  }

  @media (max-width: 480px) {
    .contact {
      padding: var(--space-8) 0;
    }
    h2 {
      font-size: var(--text-2xl);
    }
    .intro,
    .focus {
      font-size: var(--text-sm);
    }
    .link-item {
      font-size: var(--text-sm);
      overflow-wrap: break-word;
      word-break: normal;
      margin-left: 0;
      padding: var(--space-3);
    }
  }
</style>
