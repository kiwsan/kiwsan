---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

type PersonalEntry = CollectionEntry<'projects'> & {
  data: { type: 'personal' };
};

const projects = (await getCollection('projects'))
  .filter((p): p is PersonalEntry => p.data.type === 'personal')
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="projects">
  <div class="container">
    <span class="section-label">Portfolio</span>
    <h2>Featured Projects</h2>
    <div class="projects-grid">
      {projects.map((project) => (
        <article class="project-entry">
          <div class="project-layout">
            <div class="project-info">
              <div class="project-header">
                <h3>{project.data.title}</h3>
                <div class="meta">
                  <span class="company">{project.data.company}</span>
                  <time
                    class="period"
                    datetime={
                      project.data.period.includes('Present')
                        ? `${project.data.period.split(' - ')[0]}/P${new Date().getFullYear() - parseInt(project.data.period.split(' - ')[0])}Y`
                        : project.data.period
                    }
                  >
                    {project.data.period}
                  </time>
                </div>
              </div>

              <div class="project-content">
                <div class="section">
                  <strong>Challenge:</strong> {project.data.challenge}
                </div>
                <div class="section">
                  <strong>Solution:</strong> {project.data.solution}
                </div>
              </div>

              <div class="tech-stack">
                {project.data.tech.map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>

              <div class="results">
                <strong>Results:</strong>
                <ul>
                  {project.data.results.map((result) => (
                    <li>{result}</li>
                  ))}
                </ul>
              </div>

              {project.data.link && (
                <a
                  href={project.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link"
                  aria-label={`Visit ${project.data.title} (opens in new tab)`}
                >
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                  Visit Project
                </a>
              )}
            </div>

            {(project.data.imageDark || project.data.imageLight) && (
              <div class="project-image">
                {project.data.imageDark && (
                  <Image
                    src={project.data.imageDark}
                    alt={`${project.data.title} screenshot`}
                    class="theme-dark"
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 100vw, 400px"
                    format="webp"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {project.data.imageLight && (
                  <Image
                    src={project.data.imageLight}
                    alt={`${project.data.title} screenshot`}
                    class="theme-light"
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 100vw, 400px"
                    format="webp"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-rule);
  }

  h2 {
    margin-bottom: var(--space-8);
    font-size: var(--text-section);
  }

  .projects-grid {
    display: grid;
    border-top: 1px solid var(--color-rule);
  }

  .project-entry {
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .project-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    gap: var(--space-8);
    align-items: start;
  }

  .project-info {
    min-width: 0;
  }

  .project-image {
    width: 100%;
    max-width: 24rem;
  }

  .project-image img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-plate);
  }

  .project-image .theme-dark {
    display: none;
  }

  .project-image .theme-light {
    display: block;
  }

  /* Theme overrides live on <html>, so they must escape Astro's scoped cid. */
  :global([data-theme='dark']) .project-image .theme-dark {
    display: block;
  }

  :global([data-theme='dark']) .project-image .theme-light {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .project-image .theme-dark {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .project-image .theme-light {
      display: none;
    }
  }

  .project-header h3 {
    margin-bottom: var(--space-1);
    font-family: var(--font-body);
    font-size: var(--text-lede);
    font-weight: 600;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .meta .period {
    font-variant-numeric: tabular-nums;
  }

  .project-content {
    margin-top: var(--space-4);
  }

  .project-content .section {
    max-width: 62ch;
    margin-top: var(--space-2);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .project-content strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .tech-tag {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-inline);
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .results {
    margin-top: var(--space-4);
    font-size: var(--text-body);
  }

  .results strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  .results ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-2);
    list-style: none;
  }

  .results li {
    position: relative;
    max-width: 62ch;
    padding-left: var(--space-4);
    line-height: 1.6;
  }

  .results li::before {
    content: '';
    position: absolute;
    top: 0.75em;
    left: 0;
    width: 0.5rem;
    height: 1px;
    background: var(--color-ink-muted);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: var(--text-small);
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .project-link:hover {
    color: var(--color-signal);
    text-decoration-thickness: 2px;
  }

  .project-link:active {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.1em;
  }

  .project-link svg {
    flex: none;
  }

  @media (max-width: 1024px) {
    .project-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .project-image {
      max-width: 36rem;
    }
  }

  @media (max-width: 768px) {
    .projects {
      padding: var(--space-12) 0;
    }

    .project-entry {
      padding: var(--space-6) 0;
    }
  }
</style>
