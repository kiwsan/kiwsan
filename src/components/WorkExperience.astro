---
import { getCollection } from 'astro:content';

const workExperience = (await getCollection('projects'))
  .filter((p) => p.data.type === 'work')
  .sort((a, b) => a.data.order - b.data.order);

/* Tokyo Night rotation: one color per run so each job reads as its own
   desk at a glance. */
const accents = ['#7aa2f7', '#bb9af7', '#f7768e', '#7dcfff', '#9ece6a', '#e0af68', '#ff9e64'];

/* Desk pill: companies drop their legal suffix and the SET note. */
const deskLabel = (company: string) =>
  company
    .replace(/\([^)]*\)/g, '')
    .replace(/(Co\.,?|Ltd\.,?|Company|Co\b)/gi, '')
    .replace(/[^A-Za-z0-9 .&-]/g, '')
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .join(' ');

/* Isometric primitives for one mini desk. cx/cy is the centre of the top face;
   the desk sits at 100,88 inside a 200x150 viewBox so it stays centred on the
   timeline spine. */
const cube = (cx: number, cy: number, w: number, h: number, v: number) => ({
  top: `M${cx},${cy - h} L${cx + w},${cy} L${cx},${cy + h} L${cx - w},${cy} Z`,
  left: `M${cx - w},${cy} L${cx},${cy + h} L${cx},${cy + h + v} L${cx - w},${cy + v} Z`,
  right: `M${cx + w},${cy} L${cx},${cy + h} L${cx},${cy + h + v} L${cx + w},${cy + v} Z`,
  edge: `M${cx - w},${cy} L${cx},${cy - h} L${cx + w},${cy}`,
  sides: `M${cx - w},${cy} L${cx - w},${cy + v} M${cx},${cy + h} L${cx},${cy + h + v} M${cx + w},${cy} L${cx + w},${cy + v}`,
});

const diamond = (cx: number, cy: number, w: number, h: number, scale = 1) =>
  `M${cx},${cy - h * scale} L${cx + w * scale},${cy} L${cx},${cy + h * scale} L${cx - w * scale},${cy} Z`;

const deskBody = cube(100, 88, 44, 22, 13);
const deskHalo = diamond(100, 88, 44, 22, 1.15);

/* Display-only: the run periods read better with a real dash on the rail. */
const railPeriod = (period: string) => period.replace(/\s+-\s+/g, ' — ');

const runs = workExperience.map((work, index) => {
  const name = deskLabel(work.data.company);

  return {
    zone: `run-${String(index + 1).padStart(2, '0')}`,
    title: work.data.title,
    company: work.data.company,
    name: name || work.data.company,
    period: work.data.period,
    railPeriod: railPeriod(work.data.period),
    datetime: /^\d{4}/.test(work.data.period) ? work.data.period.slice(0, 4) : work.data.period,
    challenge: work.data.challenge,
    solution: work.data.solution,
    tech: work.data.tech,
    results: work.data.results,
    command: `agent run --org "${work.data.company}" --role "${work.data.title}"`,
    accent: accents[index % accents.length],
    runNo: String(index + 1).padStart(2, '0'),
    total: String(workExperience.length).padStart(2, '0'),
    floatDelay: `${(index * 0.45).toFixed(2)}s`,
  };
});

const onlineCount = String(workExperience.length).padStart(2, '0');
---

<script is:inline>
  // Runs during parse, before first paint, so the reveal gate is never missed.
  document.documentElement.dataset.trace = 'pending';
</script>

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="container">
    <div class="experience-head">
      <span class="section-label">Career</span>
      <h2 id="experience-title">Work Experience</h2>
      <p class="trace-caption">
        Every shipped run, oldest to newest. The office floor scrolls with the story.
      </p>
    </div>

    <div class="office-stage">
      <div class="scene-meta" aria-hidden="true">
        <span class="meta-line">career floor</span>
        <span class="meta-chip"><i class="meta-dot"></i>agents online · {onlineCount}</span>
      </div>

      <div class="timeline">
        <div class="timeline-spine" aria-hidden="true"></div>
        <div class="timeline-packet" aria-hidden="true"></div>

        {runs.map((run) => (
          <div class="tl-row" data-zone={run.zone} style={`--accent:${run.accent}`}>
            <div class="tl-rail">
              <span class="tl-period">{run.railPeriod}</span>

              <svg class="tl-desk" viewBox="0 0 200 150" aria-hidden="true">
                <path d={deskHalo} fill={run.accent} opacity="0.06" />
                <path d={deskBody.left} fill="#1b2030" />
                <path d={deskBody.right} fill="#161a26" />
                <path d={deskBody.top} fill="#262c3e" />
                <rect
                  x="90"
                  y="52"
                  width="20"
                  height="16"
                  rx="2"
                  fill="#0e1018"
                  stroke={run.accent}
                  stroke-opacity="0.85"
                />
                <path
                  d="M100 68 L100 80"
                  stroke={run.accent}
                  stroke-opacity="0.55"
                  stroke-width="1.5"
                />
                <path
                  d={deskBody.edge}
                  fill="none"
                  stroke={run.accent}
                  stroke-opacity="0.85"
                  stroke-width="1.5"
                />
                <path
                  d={deskBody.sides}
                  fill="none"
                  stroke={run.accent}
                  stroke-opacity="0.34"
                  stroke-width="1.2"
                />
                <g transform="translate(100,80)">
                  <g class="agent" style={`animation-delay:${run.floatDelay}`}>
                    <polygon points="0,-46 5,-38 0,-30 -5,-38" fill={run.accent} opacity="0.9" />
                    <polygon points="0,-46 9,-38 0,-30 -9,-38" fill={run.accent} opacity="0.12" />
                  </g>
                </g>
              </svg>

              <span class="tl-node" aria-hidden="true"></span>

              <span class="tl-pill desk-pill">
                <span class="desk-name">{run.name}</span>
                <span class="desk-period">{run.period}</span>
              </span>
            </div>

            <article
              class="trace-block work-card"
              data-zone={run.zone}
              style={`--accent:${run.accent}`}
              aria-labelledby={`run-role-${run.zone}`}
            >
              <div class="trace-line trace-cmd" style="--i:0" aria-label={`$ ${run.command}`}>
                <span class="prompt" aria-hidden="true">$</span>
                <span class="cmd" aria-hidden="true" data-cmd data-full={run.command}>{run.command}</span>
                <span class="cursor" aria-hidden="true"></span>
                <span class="run-no" aria-hidden="true">
                  <svg class="desk-glyph" viewBox="0 0 12 10" width="12" height="10">
                    <polygon points="6,0 11,3 6,6 1,3" fill="currentColor" opacity="0.9" />
                    <polygon points="1,3 6,6 6,9 1,6" fill="currentColor" opacity="0.45" />
                    <polygon points="11,3 6,6 6,9 11,6" fill="currentColor" opacity="0.28" />
                  </svg>
                  <b>{run.runNo}</b>/{run.total}
                </span>
              </div>

              <div class="trace-line trace-kv" style="--i:1">
                <span class="k">role</span>
                <h3 id={`run-role-${run.zone}`}>{run.title}</h3>
              </div>

              <div class="trace-line trace-kv" style="--i:2">
                <span class="k">org</span>
                <span class="company">{run.company}</span>
              </div>

              <div class="trace-line trace-kv" style="--i:3">
                <span class="k">period</span>
                <time class="period" datetime={run.datetime}>{run.period}</time>
              </div>

              <div class="trace-line trace-kv" style="--i:4">
                <span class="k">task</span>
                <p class="prose">{run.challenge}</p>
              </div>

              <div class="trace-line trace-kv" style="--i:5">
                <span class="k">impl</span>
                <p class="prose">{run.solution}</p>
              </div>

              <div class="trace-line trace-tool" style="--i:6">
                <span class="arrow" aria-hidden="true">▸</span>
                <span class="tool-label">tool_call({run.tech.length})</span>
              </div>

              <div class="trace-line trace-chips" style="--i:7">
                {run.tech.map((tech) => <span class="tech-tag">{tech}</span>)}
              </div>

              <ul class="results">
                {run.results.map((result, i) => (
                  <li class="trace-line" style={`--i:${8 + i}`}>
                    <span class="ok" aria-hidden="true">✔</span>
                    <span>{result}</span>
                  </li>
                ))}
              </ul>
            </article>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('#experience .office-stage');

  if (stage) {
    const root = document.documentElement;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('.work-card'));
    const timeline = stage.querySelector<HTMLElement>('.timeline');
    const spine = stage.querySelector<HTMLElement>('.timeline-spine');
    const lastNode = stage.querySelector<HTMLElement>('.tl-row:last-child .tl-node');
    const timers = new Map<HTMLElement, number>();
    let observer: IntersectionObserver | null = null;

    /* Trim the spine to the last node (CSS stretches it to the floor when
       this never runs, e.g. with JS off). */
    const sizeSpine = () => {
      if (!timeline || !spine || !lastNode) return;
      const box = timeline.getBoundingClientRect();
      const node = lastNode.getBoundingClientRect();
      if (box.height === 0 || node.height === 0) return;
      timeline.style.setProperty('--spine-h', `${Math.max(0, node.top + node.height / 2 - box.top - 8)}px`);
    };

    sizeSpine();
    window.addEventListener('resize', sizeSpine);
    document.fonts?.ready.then(sizeSpine);

    if (typeof ResizeObserver !== 'undefined' && timeline) {
      new ResizeObserver(sizeSpine).observe(timeline);
    }

    const commandOf = (card: HTMLElement) => card.querySelector<HTMLElement>('[data-cmd]');

    /* Type once per card, capped at 620ms however long the command is. */
    const typeCommand = (card: HTMLElement) => {
      const cmd = commandOf(card);
      const text = cmd?.dataset.full ?? '';

      if (!cmd || text.length === 0) {
        card.classList.add('is-done');
        return;
      }

      cmd.textContent = '';
      card.classList.remove('is-done');

      const step = Math.max(6, Math.min(16, 620 / text.length));
      let shown = 0;

      const timer = window.setInterval(() => {
        shown += 1;
        cmd.textContent = text.slice(0, shown);
        if (shown >= text.length) {
          clearInterval(timer);
          timers.delete(card);
          card.classList.add('is-done');
        }
      }, step);
      timers.set(card, timer);
    };

    /* Finish any typing in flight so a card never gets left half-written. */
    const settle = (card: HTMLElement) => {
      const timer = timers.get(card);
      if (timer !== undefined) {
        clearInterval(timer);
        timers.delete(card);
      }
      const cmd = commandOf(card);
      if (cmd) cmd.textContent = cmd.dataset.full ?? '';
      card.classList.add('is-done');
    };

    const reveal = (card: HTMLElement) => {
      if (card.dataset.revealed === 'true') return;
      card.dataset.revealed = 'true';
      card.classList.add('is-live');
      typeCommand(card);
    };

    /* No motion budget or no observer: everything is already live. */
    const revealAll = () => {
      for (const card of cards) {
        card.classList.add('is-live');
        settle(card);
      }
      root.dataset.trace = 'done';
    };

    /* If a visitor jumps past runs, mark the ones above the landing card as
       already read so their text never stays hidden. Runs below the landing
       card keep waiting for their own intersection. */
    const passThrough = (landed: HTMLElement) => {
      const index = cards.indexOf(landed);
      if (index < 1) return;

      for (let i = 0; i < index; i += 1) {
        const card = cards[i];
        if (card.dataset.revealed === 'true') continue;
        card.dataset.revealed = 'true';
        card.classList.add('is-live');
        settle(card);
      }
    };

    if (reducedMotion.matches || typeof IntersectionObserver === 'undefined' || cards.length === 0) {
      revealAll();
    } else {
      observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const card = entry.target as HTMLElement;
            observer?.unobserve(card);
            passThrough(card);
            reveal(card);
          }
        },
        { rootMargin: '0px 0px -18% 0px', threshold: 0.05 }
      );

      for (const card of cards) observer.observe(card);

      window.addEventListener('pagehide', () => {
        for (const card of cards) settle(card);
      });
    }

    reducedMotion.addEventListener('change', (event) => {
      if (!event.matches) return;
      observer?.disconnect();
      observer = null;
      revealAll();
    });

    document.addEventListener('astro:before-swap', () => {
      observer?.disconnect();
      observer = null;
      timers.forEach((timer) => clearInterval(timer));
      timers.clear();
    });
  }
</script>

<style>
  .experience {
    padding: var(--space-16) 0;
  }

  .experience-head {
    max-width: 68ch;
    margin-bottom: var(--space-8);
  }

  h2 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-3);
  }

  .trace-caption {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  /* One dark floor holds the whole run history: rail on the left, trace on
     the right, both scrolling down the career. */
  .office-stage {
    --t-bg: #15161f;
    --t-fg: #c0caf5;
    --t-dim: #565f89;
    --t-muted: #a9b1d6;
    --t-purple: #bb9af7;
    --t-green: #9ece6a;
    --t-chip: #1d202f;

    padding: clamp(20px, 3vw, 36px);
    border-radius: 16px;
    background: var(--t-bg);
    box-shadow: 0 24px 64px -24px rgba(0, 0, 0, 0.45);
    color: var(--t-fg);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.75;
  }

  .scene-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: clamp(24px, 3vw, 36px);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #565f89;
  }

  .meta-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #1d202f;
    color: #9ece6a;
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.5);
  }

  .meta-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #9ece6a;
    box-shadow: 0 0 8px rgba(158, 206, 106, 0.8);
    animation: meta-pulse 2.4s ease-in-out infinite;
  }

  @keyframes meta-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  /* The spine lives in the left rail column and runs from the first node to
     the end of the floor, fading out under the last card. */
  .timeline {
    --spine-x: 110px;

    position: relative;
    display: grid;
    gap: 48px;
  }

  .timeline-spine {
    position: absolute;
    top: 8px;
    bottom: 0;
    height: var(--spine-h, auto);
    left: calc(var(--spine-x) - 1px);
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(
      180deg,
      #7aa2f7 0%,
      #bb9af7 52%,
      rgba(247, 118, 142, 0.55) 88%,
      rgba(247, 118, 142, 0) 100%
    );
    opacity: 0.35;
    pointer-events: none;
  }

  /* One run at a time travels the rail, so the floor keeps a pulse even
     when the visitor stops scrolling. */
  .timeline-packet {
    position: absolute;
    top: 8px;
    left: calc(var(--spine-x) - 5px);
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #7aa2f7;
    box-shadow:
      0 0 10px 2px rgba(122, 162, 247, 0.5),
      0 0 26px 6px rgba(122, 162, 247, 0.18);
    animation: timeline-packet 11s linear infinite both;
    pointer-events: none;
    z-index: 2;
  }

  @keyframes timeline-packet {
    0% {
      top: 8px;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: calc(var(--spine-h, 100%) - 4px);
      opacity: 0;
    }
  }

  .tl-row {
    position: relative;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    column-gap: 40px;
    align-items: start;
  }

  .tl-rail {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .tl-period {
    max-width: 100px;
    font-size: 10.5px;
    line-height: 1.6;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #565f89;
  }

  .tl-desk {
    display: block;
    width: 200px;
    max-width: 100%;
    height: auto;
    margin: 2px auto 0;
  }

  /* Node: sits on the spine at the run card's top edge. */
  .tl-node {
    position: absolute;
    top: 2px;
    left: calc(var(--spine-x) - 6px);
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 65%, #15161f);
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--accent) 26%, transparent),
      0 0 16px -2px color-mix(in srgb, var(--accent) 55%, transparent);
    z-index: 3;
  }

  .agent {
    animation: agent-float 4.5s ease-in-out infinite alternate;
  }

  @keyframes agent-float {
    to {
      transform: translateY(-3px);
    }
  }

  /* Pill under the desk: tonal plate, accent glow, no hit target anymore. */
  .tl-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    width: fit-content;
    margin: 4px auto 0;
    padding: 3px 10px;
    border-radius: 999px;
    background: #1d202f;
    text-align: center;
    box-shadow: 0 10px 22px -14px color-mix(in srgb, var(--accent) 65%, transparent);
  }

  .desk-name {
    font-size: 9px;
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--accent);
  }

  .desk-period {
    font-size: 7.5px;
    line-height: 1.3;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--t-dim);
  }

  /* Each run is its own raised sheet: tonal lift on the floor, an accent rail
     in the run's rotation color, and a numbered chip so jobs never blur. */
  .trace-block {
    display: block;
    position: relative;
    background: #191c28;
    border-left: 3px solid var(--accent);
    border-radius: 0 12px 12px 0;
    padding: 16px 22px;
  }

  .trace-line {
    display: block;
  }

  .trace-cmd {
    color: var(--t-fg);
    overflow-wrap: anywhere;
    display: flex;
    align-items: baseline;
    column-gap: 0.75ch;
    min-height: 1.75em;
  }

  .cmd {
    white-space: pre-wrap;
    min-width: 0;
    flex: 1;
  }

  .run-no {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--t-dim);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .desk-glyph {
    color: var(--accent);
  }

  .run-no b {
    color: var(--accent);
    font-weight: 600;
  }

  .prompt {
    color: var(--accent);
    margin-right: 0;
    flex: none;
  }

  .cursor {
    display: none;
    width: 0.6ch;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--t-fg);
    animation: trace-blink 0.9s steps(2, start) infinite;
  }

  :global([data-trace='pending']) .work-card.is-live:not(.is-done) .cursor {
    display: inline-block;
  }

  @keyframes trace-blink {
    50% { opacity: 0; }
  }

  .trace-kv {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    column-gap: 18px;
    align-items: baseline;
  }

  .k {
    color: var(--t-dim);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h3 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: 0;
    color: var(--accent);
  }

  .prose {
    margin: 0;
    max-width: 68ch;
    color: var(--t-muted);
  }

  .trace-tool {
    display: flex;
    align-items: baseline;
    gap: 0.75ch;
    margin-top: 4px;
  }

  .arrow {
    color: var(--t-purple);
  }

  .tool-label {
    color: var(--t-dim);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .trace-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-left: 2ch;
  }

  .tech-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--t-chip);
    color: var(--t-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s ease;
  }

  .tech-tag:hover {
    transform: translateY(-2px);
    color: var(--t-purple);
  }

  .results {
    list-style: none;
    margin: 6px 0 0;
    padding: 0 0 0 2ch;
  }

  .results li {
    display: flex;
    align-items: baseline;
    gap: 0.75ch;
    color: var(--t-muted);
  }

  .ok {
    color: var(--t-green);
  }

  /* Reveal gate: only while the inline script says 'pending'. No JS leaves the
     attribute unset, so the whole trace stays visible. Each card opens on its
     own intersection, so cards further down keep waiting their turn. */
  :global([data-trace='pending']) .trace-line {
    opacity: 0;
    transform: translateY(6px);
  }

  :global([data-trace='pending']) .work-card.is-live .trace-line {
    opacity: 1;
    transform: none;
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(120ms + var(--i) * 70ms);
  }

  @keyframes trace-pop {
