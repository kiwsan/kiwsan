---
import { getCollection } from 'astro:content';

const workExperience = (await getCollection('projects'))
  .filter(p => p.data.type === 'work')
  .sort((a, b) => a.data.order - b.data.order);

/* Tokyo Night rotation: one color per run so each job reads as its own
   card at a glance. */
const accents = ['#7aa2f7', '#bb9af7', '#f7768e', '#7dcfff', '#9ece6a', '#e0af68', '#ff9e64'];

/* Desk anchors inside the isometric office, one per run (back row, front row). */
const desks = [
  [120, 150],
  [200, 136],
  [280, 150],
  [120, 188],
  [200, 204],
  [280, 188],
];

const runs = workExperience.map((work, index) => ({
  title: work.data.title,
  company: work.data.company,
  period: work.data.period,
  datetime: /^\d{4}/.test(work.data.period) ? work.data.period.slice(0, 4) : work.data.period,
  challenge: work.data.challenge,
  solution: work.data.solution,
  tech: work.data.tech,
  results: work.data.results,
  command: `agent run --org "${work.data.company}" --role "${work.data.title}"`,
  accent: accents[index % accents.length],
  runNo: String(index + 1).padStart(2, '0'),
  total: String(workExperience.length).padStart(2, '0'),
}));
---

<script is:inline>
  // Runs during parse, before first paint, so the reveal gate is never missed.
  document.documentElement.dataset.trace = 'pending';
</script>

<section id="experience" class="experience">
  <div class="container">
    <div class="experience-head">
      <div class="head-copy">
        <span class="section-label">Career</span>
        <h2>Work Experience</h2>
        <p class="trace-caption">A run report, newest first. Every line is shipped work.</p>
      </div>

      <div class="office" aria-hidden="true">
        <span class="office-chip chip-mcp">MCP</span>
        <span class="office-chip chip-live"><i></i>LIVE</span>
        <svg class="office-svg" viewBox="20 50 360 210" role="presentation">
          <defs>
            <linearGradient id="office-floor" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#1c2030" />
              <stop offset="1" stop-color="#13151f" />
            </linearGradient>
          </defs>

          <g stroke="#565f89" stroke-width="1" stroke-dasharray="2 5" opacity="0.3">
            {desks.map(([x, y]) => <path d={`M306 166 L${x} ${y - 4}`} />)}
          </g>

          <path d="M200 86 L352 162 L200 238 L48 162 Z" fill="url(#office-floor)" stroke="#7aa2f7" stroke-opacity="0.28" />
          <g stroke="#ffffff" stroke-opacity="0.045">
            <path d="M86 143 L238 219" /><path d="M124 124 L276 200" /><path d="M162 105 L314 181" />
            <path d="M86 181 L238 105" /><path d="M124 200 L276 124" /><path d="M162 219 L314 143" />
          </g>

          <!-- AI core: the gateway every run flows through. -->
          <g transform="translate(306,172) scale(1.12)">
            <path d="M-14 0 L0 7 L0 17 L-14 10 Z" fill="#1b2030" />
            <path d="M14 0 L0 7 L0 17 L14 10 Z" fill="#161a26" />
            <path d="M0 -7 L14 0 L0 7 L-14 0 Z" fill="#262c3e" stroke="#7aa2f7" stroke-opacity="0.5" />
            <circle cx="0" cy="-15" r="7" fill="#7aa2f7" opacity="0.14" />
            <circle cx="0" cy="-15" r="2.6" fill="#7aa2f7" />
          </g>

          {runs.map((run, i) => (
            <g transform={`translate(${desks[i][0]},${desks[i][1]}) scale(1.12)`}>
              <path d="M-26 0 L0 13 L0 23 L-26 10 Z" fill="#1b2030" />
              <path d="M26 0 L0 13 L0 23 L26 10 Z" fill="#161a26" />
              <path d="M0 -13 L26 0 L0 13 L-26 0 Z" fill="#262c3e" />
              <path d="M-26 0 L0 -13 L26 0" fill="none" stroke={run.accent} stroke-opacity="0.9" stroke-width="1.5" />
              <ellipse cx="4" cy="-3" rx="16" ry="4" fill={run.accent} opacity="0.1" />
              <rect x="-9" y="-29" width="18" height="12" rx="2" fill="#0e1018" stroke={run.accent} stroke-opacity="0.8" />
              <g class="agent" style={`animation-delay:${i * 0.45}s`}>
                <polygon points="0,-46 5,-38 0,-30 -5,-38" fill={run.accent} opacity="0.9" />
                <polygon points="0,-46 9,-38 0,-30 -9,-38" fill={run.accent} opacity="0.12" />
              </g>
            </g>
          ))}
        </svg>
      </div>
    </div>

    <div class="terminal">
      <div class="term-bar">
        <span class="dot dot-red" aria-hidden="true"></span>
        <span class="dot dot-yellow" aria-hidden="true"></span>
        <span class="dot dot-green" aria-hidden="true"></span>
        <span class="term-title">kiwsan@career:~ — agent trace</span>
      </div>

      <div class="term-body">
        {runs.map((run) => (
          <article class="trace-block work-card" style={`--accent:${run.accent}`}>
            <div class="trace-line trace-cmd" style="--i:0" aria-label={`$ ${run.command}`}>
              <span class="prompt" aria-hidden="true">$</span>
              <span class="cmd" aria-hidden="true" data-cmd>{run.command}</span>
              <span class="cursor" aria-hidden="true"></span>
              <span class="run-no" aria-hidden="true">
                <svg class="desk-glyph" viewBox="0 0 12 10" width="12" height="10">
                  <polygon points="6,0 11,3 6,6 1,3" fill="currentColor" opacity="0.9" />
                  <polygon points="1,3 6,6 6,9 1,6" fill="currentColor" opacity="0.45" />
                  <polygon points="11,3 6,6 6,9 11,6" fill="currentColor" opacity="0.28" />
                </svg>
                <b>{run.runNo}</b>/{run.total}
              </span>
            </div>

            <div class="trace-line trace-kv" style="--i:1">
              <span class="k">role</span>
              <h3>{run.title}</h3>
            </div>

            <div class="trace-line trace-kv" style="--i:2">
              <span class="k">org</span>
              <span class="company">{run.company}</span>
            </div>

            <div class="trace-line trace-kv" style="--i:3">
              <span class="k">period</span>
              <time class="period" datetime={run.datetime}>{run.period}</time>
            </div>

            <div class="trace-line trace-kv" style="--i:4">
              <span class="k">task</span>
              <p class="prose">{run.challenge}</p>
            </div>

            <div class="trace-line trace-kv" style="--i:5">
              <span class="k">impl</span>
              <p class="prose">{run.solution}</p>
            </div>

            <div class="trace-line trace-tool" style="--i:6">
              <span class="arrow" aria-hidden="true">▸</span>
              <span class="tool-label">tool_call({run.tech.length})</span>
            </div>

            <div class="trace-line trace-chips" style="--i:7">
              {run.tech.map((tech) => <span class="tech-tag">{tech}</span>)}
            </div>

            <ul class="results">
              {run.results.map((result, i) => (
                <li class="trace-line" style={`--i:${8 + i}`}>
                  <span class="ok" aria-hidden="true">✔</span>
                  <span>{result}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}

        <p class="eof" aria-hidden="true">-- EOF --</p>
      </div>
    </div>
  </div>
</section>

<script>
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('#experience .trace-block'));
  const root = document.documentElement;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const timers = new Set<number>();
  let observer: IntersectionObserver | null = null;
  let pending = blocks.length;

  const cleanup = () => {
    observer?.disconnect();
    observer = null;
    timers.forEach((timer) => clearInterval(timer));
    timers.clear();
    document.removeEventListener('astro:before-swap', cleanup);
  };

  const finish = () => {
    root.dataset.trace = 'done';
    cleanup();
  };

  const typeCommand = (block: HTMLElement) => {
    const cmd = block.querySelector<HTMLElement>('[data-cmd]');
    const done = () => {
      block.classList.add('is-done');
      pending -= 1;
      if (pending <= 0) finish();
    };

    const text = cmd?.textContent ?? '';
    if (!cmd || text.length === 0) {
      done();
      return;
    }

    const step = Math.min(16, 700 / text.length);
    let shown = 0;
    cmd.textContent = '';

    const timer = window.setInterval(() => {
      shown += 1;
      cmd.textContent = text.slice(0, shown);
      if (shown >= text.length) {
        clearInterval(timer);
        timers.delete(timer);
        done();
      }
    }, step);
    timers.add(timer);
  };

  document.addEventListener('astro:before-swap', cleanup);

  if (blocks.length === 0 || reducedMotion.matches || typeof IntersectionObserver === 'undefined') {
    finish();
  } else {
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const block = entry.target as HTMLElement;
          observer?.unobserve(block);
          block.classList.add('is-live');
          typeCommand(block);
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );
    blocks.forEach((block) => observer?.observe(block));
  }
</script>

<style>
  .experience {
    padding: var(--space-16) 0;
  }

  .experience-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }

  .head-copy {
    flex: 1;
    min-width: 0;
  }

  h2 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-3);
  }

  .trace-caption {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  /* The AI agent office: one isometric room where every run below works.
     Static SVG, accent colors shared with the run cards. */
  .office {
    position: relative;
    flex: none;
    width: clamp(320px, 36vw, 430px);
    border-radius: 14px;
    background: #15161f;
    box-shadow: 0 24px 64px -24px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  .office-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .office-chip {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(122, 162, 247, 0.18);
    background: rgba(21, 22, 31, 0.75);
    color: #565f89;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .chip-mcp {
    top: 14px;
    left: 14px;
  }

  .chip-live {
    top: 14px;
    right: 14px;
    color: #9ece6a;
  }

  .chip-live i {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: #9ece6a;
    animation: live-pulse 1.6s ease-in-out infinite;
  }

  @keyframes live-pulse {
    50% {
      opacity: 0.35;
    }
  }

  .agent {
    animation: agent-float 4.5s ease-in-out infinite alternate;
  }

  @keyframes agent-float {
    to {
      transform: translateY(-3px);
    }
  }

  /* One dark terminal on both themes: a deliberate contrast object in light
     mode, a natural Tokyo Night surface in dark mode. */
  .terminal {
    --t-bg: #15161f;
    --t-fg: #c0caf5;
    --t-dim: #565f89;
    --t-muted: #a9b1d6;
    --t-blue: #7aa2f7;
    --t-purple: #bb9af7;
    --t-green: #9ece6a;
    --t-chip: #1d202f;

    position: relative;
    overflow: hidden;
    border-radius: 14px;
    background: var(--t-bg);
    box-shadow: 0 24px 64px -24px rgba(0, 0, 0, 0.45);
    color: var(--t-fg);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.75;
  }

  .terminal::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: repeating-linear-gradient(
      rgba(255, 255, 255, 0.015) 0 1px,
      transparent 1px 3px
    );
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px clamp(20px, 4vw, 40px) 0;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    flex: none;
  }

  .dot-red { background: #f7768e; }
  .dot-yellow { background: #e0af68; }
  .dot-green { background: #9ece6a; }

  .term-title {
    margin-left: auto;
    color: var(--t-dim);
    font-size: 12px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .term-body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(20px, 4vw, 40px);
  }

  /* Each run is its own raised sheet: tonal lift on the terminal body, an
     accent rail in the run's rotation color, and a numbered chip on the
     right so separate jobs never blur together. */
  .trace-block {
    display: block;
    position: relative;
    background: #191c28;
    border-left: 3px solid var(--accent);
    border-radius: 0 12px 12px 0;
    padding: 16px 22px;
  }

  .trace-line {
    display: block;
  }

  .trace-cmd {
    color: var(--t-fg);
    overflow-wrap: anywhere;
    display: flex;
    align-items: baseline;
    column-gap: 0.75ch;
  }

  .cmd {
    white-space: pre-wrap;
    min-width: 0;
    flex: 1;
  }

  .run-no {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--t-dim);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .desk-glyph {
    color: var(--accent);
  }

  .run-no b {
    color: var(--accent);
    font-weight: 600;
  }

  .prompt {
    color: var(--accent);
    margin-right: 0;
    flex: none;
  }

  .cursor {
    display: none;
    width: 0.6ch;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--t-fg);
    animation: trace-blink 0.9s steps(2, start) infinite;
  }

  :global([data-trace='pending']) .trace-block.is-live:not(.is-done) .cursor {
    display: inline-block;
  }

  @keyframes trace-blink {
    50% { opacity: 0; }
  }

  .trace-kv {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    column-gap: 18px;
    align-items: baseline;
  }

  .k {
    color: var(--t-dim);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h3 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: 0;
    color: var(--accent);
  }

  .prose {
    margin: 0;
    max-width: 68ch;
    color: var(--t-muted);
  }

  .trace-tool {
    display: flex;
    align-items: baseline;
    gap: 0.75ch;
    margin-top: 4px;
  }

  .arrow {
    color: var(--t-purple);
  }

  .tool-label {
    color: var(--t-dim);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .trace-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-left: 2ch;
  }

  .tech-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--t-chip);
    color: var(--t-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s ease;
  }

  .tech-tag:hover {
    transform: translateY(-2px);
    color: var(--t-purple);
  }

  .results {
    list-style: none;
    margin: 6px 0 0;
    padding: 0 0 0 2ch;
  }

  .results li {
    display: flex;
    align-items: baseline;
    gap: 0.75ch;
    color: var(--t-muted);
  }

  .ok {
    color: var(--t-green);
  }

  .eof {
    margin: 0;
    color: var(--t-dim);
    font-size: 12px;
  }

  /* Reveal gate: only while the inline script says 'pending'. No JS leaves the
     attribute unset, so the whole trace stays visible. */
  :global([data-trace='pending']) .trace-line {
    opacity: 0;
    transform: translateY(6px);
  }

  :global([data-trace='pending']) .trace-block.is-live .trace-line {
    opacity: 1;
    transform: none;
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(120ms + var(--i) * 70ms);
  }

  @keyframes trace-pop {
    from { transform: scale(0.86); }
    to { transform: scale(1); }
  }

  :global([data-trace='pending']) .trace-block.is-live .results li {
    animation: trace-pop 0.36s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(120ms + var(--i) * 70ms);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .trace-block {
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                  background-color 0.25s ease;
    }

    .trace-block:hover {
      transform: perspective(1000px) rotateX(0.6deg) rotateY(-1.2deg) translateY(-2px);
      background: #1b1f2e;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-tag:hover {
      transform: none;
    }

    .office .agent,
    .chip-live i {
      animation: none;
    }

    /* Belt and suspenders: even if the script never runs, reduced motion
       users see the full trace. */
    :global([data-trace='pending']) .trace-line {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .experience-head {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-5);
    }

    .office {
      width: min(100%, 460px);
    }
  }

  @media (max-width: 640px) {
    .experience {
      padding: var(--space-12) 0;
    }

    h2 {
      font-size: var(--text-3xl);
    }

    .terminal {
      font-size: 12px;
    }

    .trace-block {
      padding: 14px 16px;
      border-left-width: 2px;
    }

    .trace-kv {
      grid-template-columns: 62px minmax(0, 1fr);
      column-gap: 12px;
    }

    h3 {
      font-size: 13px;
    }

    .term-title {
      font-size: 11px;
    }
  }
</style>
