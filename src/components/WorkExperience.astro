---
import { getCollection } from 'astro:content';

const workExperience = (await getCollection('projects'))
  .filter(p => p.data.type === 'work')
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" class="experience">
  <div class="container">
    <span class="section-label">Career</span>
    <h2>Work Experience</h2>
    <div class="timeline">
      <div class="timeline-line" aria-hidden="true"></div>
      {workExperience.map((work, index) => (
        <article class={`timeline-item ${index % 2 === 0 ? 'timeline-left' : 'timeline-right'}`}>
          <div class="timeline-dot" aria-hidden="true">
            <span class="dot-ring"></span>
          </div>
          <div class="timeline-card work-card">
            <div class="card-accent" aria-hidden="true"></div>
            <time class="period" datetime={work.data.period.includes('Present') ? `${work.data.period.split(' - ')[0]}/P${new Date().getFullYear() - parseInt(work.data.period.split(' - ')[0])}Y` : work.data.period}>{work.data.period}</time>
            <h3>{work.data.title}</h3>
            <span class="company">{work.data.company}</span>

            <div class="work-content">
              <div class="section">
                <strong>Challenge</strong>
                <p>{work.data.challenge}</p>
              </div>
              <div class="section">
                <strong>Solution</strong>
                <p>{work.data.solution}</p>
              </div>
            </div>

            <div class="tech-stack">
              {work.data.tech.map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
            </div>

            <div class="results">
              <strong>Results</strong>
              <ul>
                {work.data.results.map((result) => (
                  <li>{result}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
  <!-- The 3D corridor re-parents the .timeline-card elements into .stage and
       drives the camera from this scroll runway. In flat mode (no JS, reduced
       motion, narrow viewport) the runway stays hidden and the timeline above
       is the whole section. -->
  <div class="runway" hidden>
    <div class="stage"></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import * as THREE from 'three';
  import { CSS3DObject, CSS3DRenderer } from 'three/addons/renderers/CSS3DRenderer.js';
  import { CORRIDOR, cameraAt, cardOpacity, place, type Placement } from '../lib/exp3d/layout';

  gsap.registerPlugin(ScrollTrigger);

  type Mode = '3d' | 'flat';

  interface CardEntry {
    el: HTMLElement;
    article: HTMLElement;
    object: CSS3DObject;
    placement: Placement;
  }

  interface Corridor {
    tween: gsap.core.Tween;
    trigger: ScrollTrigger;
    renderer: CSS3DRenderer;
    camera: THREE.PerspectiveCamera;
    entries: CardEntry[];
    render: (p: number) => void;
  }

  const section = document.getElementById('experience') as HTMLElement;
  const runwayEl = section.querySelector<HTMLElement>('.runway');
  const stageEl = section.querySelector<HTMLElement>('.stage');
  const cardEls = Array.from(section.querySelectorAll<HTMLElement>('.timeline-card'));

  // Corridor geometry lives in src/lib/exp3d/layout.ts, shared with the WebGL
  // environment so the two worlds cannot drift. Card i sits READ_DISTANCE +
  // i * SPACING ahead of the camera start, alternating left/right lanes.

  let corridor: Corridor | null = null;
  let resizeTimer: number | undefined;

  function decideMode(): Mode {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return 'flat';
    if (window.innerWidth < CORRIDOR.MIN_3D_WIDTH) return 'flat';
    if (!runwayEl || !stageEl || cardEls.length < 2) return 'flat';
    return '3d';
  }

  function enter3d(runway: HTMLElement, stage: HTMLElement): void {
    section.classList.add('is-3d');
    runway.hidden = false;

    const renderer = new CSS3DRenderer();
    renderer.domElement.style.position = 'absolute';
    renderer.domElement.style.inset = '0';
    stage.appendChild(renderer.domElement);

    const entries: CardEntry[] = [];
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(CORRIDOR.FOV, 1, 1, 20000);

    try {
      const width = stage.clientWidth;
      const height = stage.clientHeight;
      renderer.setSize(width, height);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();

      for (const [index, el] of cardEls.entries()) {
        const article = el.parentElement as HTMLElement;
        const placement = place(index, cardEls.length, width);
        const object = new CSS3DObject(el);
        object.position.set(placement.x, 0, placement.z);
        object.rotation.y = -placement.lane * CORRIDOR.TURN; // left lane faces +x, toward center
        scene.add(object);
        entries.push({ el, article, object, placement });
      }

      const travel = CORRIDOR.SPACING * (cardEls.length - 1);

      const render = (p: number) => {
        const { z, lookX } = cameraAt(p, entries.map((entry) => entry.placement));
        camera.position.set(0, 0, z);
        camera.lookAt(lookX, 0, z - CORRIDOR.LOOK_AHEAD);
        for (const entry of entries) {
          const { placement } = entry;
          const distance = Math.abs(p - placement.readAt) * travel;
          const face = Math.max(0, 1 - distance / CORRIDOR.BILLBOARD_REACH);
          // Blend the fixed lane turn toward facing the camera, so the card
          // being read sits flat while the corridor still reads as a corridor.
          const billboard = Math.atan2(lookX - placement.x, z - placement.z);
          entry.object.rotation.y = -placement.lane * CORRIDOR.TURN * (1 - face) + billboard * face;
          // CSS3DRenderer does no frustum culling; a card at or behind the camera
          // plane would project mirrored and blow up across the stage.
          entry.object.visible = z - placement.z > CORRIDOR.CULL_DISTANCE;
          entry.el.style.opacity = cardOpacity(p, placement, travel).toFixed(3);
        }
        renderer.render(scene, camera);
        Object.assign(window, {
          __exp3d: {
            mode: '3d',
            progress: p,
            camZ: z,
            lookX,
            cards: entries.map((entry) => ({
              index: entry.placement.index,
              lane: entry.placement.lane,
              x: entry.placement.x,
              z: entry.placement.z,
              opacity: entry.el.style.opacity,
              visible: entry.object.visible,
              rotationY: entry.object.rotation.y,
            })),
          },
        });
      };

      render(0);

      // Drive a proxy with a scrub-tween so progress eases after scroll stops.
      const proxy = { p: 0 };
      const tween = gsap.to(proxy, {
        p: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: runway,
          start: 'top top',
          end: 'bottom bottom',
          scrub: true,
          onUpdate: () => render(proxy.p),
        },
      });
      const trigger = tween.scrollTrigger as ScrollTrigger;

      corridor = { tween, trigger, renderer, camera, entries, render };
    } catch (error) {
      // Setup failed: put every card back in the flat timeline.
      for (const entry of entries) {
        entry.el.style.opacity = '';
        entry.article.appendChild(entry.el);
      }
      renderer.domElement.remove();
      section.classList.remove('is-3d');
      runway.hidden = true;
      throw error;
    }
  }

  function exit3d(): void {
    if (corridor) {
      corridor.tween.kill();
      for (const entry of corridor.entries) {
        entry.el.style.opacity = '';
        entry.article.appendChild(entry.el);
      }
      corridor.renderer.domElement.remove();
      corridor = null;
    }
    section.classList.remove('is-3d');
    if (runwayEl) runwayEl.hidden = true;
    Object.assign(window, { __exp3d: { mode: 'flat' } });
  }

  function syncForResize(): void {
    const mode = decideMode();
    if (mode === '3d' && corridor === null && runwayEl && stageEl) {
      enter3d(runwayEl, stageEl);
      return;
    }
    if (mode === 'flat' && corridor !== null) {
      exit3d();
      return;
    }
    if (corridor && stageEl) {
      const width = stageEl.clientWidth;
      const height = stageEl.clientHeight;
      corridor.renderer.setSize(width, height);
      corridor.camera.aspect = width / height;
      corridor.camera.updateProjectionMatrix();
      for (const entry of corridor.entries) {
        entry.placement = place(entry.placement.index, corridor.entries.length, width);
        entry.object.position.x = entry.placement.x;
      }
      ScrollTrigger.refresh();
      corridor.render(corridor.trigger.progress);
    }
  }

  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(syncForResize, 150);
  });

  try {
    if (decideMode() === '3d' && runwayEl && stageEl) {
      enter3d(runwayEl, stageEl);
    } else {
      Object.assign(window, { __exp3d: { mode: 'flat' } });
    }
  } catch (error) {
    exit3d();
    console.warn('Work Experience corridor disabled:', error);
  }
</script>

<style>
  .experience {
    padding: var(--space-16) 0;
  }

  h2 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-12);
  }

  /* ---------- Flat timeline ---------- */
  .timeline {
    position: relative;
    padding: var(--space-4) 0;
  }

  .timeline-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-border) 8%,
      var(--color-primary) 50%,
      var(--color-border) 92%,
      transparent
    );
    transform: translateX(-50%);
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-10);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-left .timeline-card {
    grid-column: 1;
    grid-row: 1;
    text-align: right;
  }

  .timeline-right .timeline-card {
    grid-column: 2;
    grid-row: 1;
  }

  .timeline-dot {
    position: absolute;
    left: 50%;
    top: var(--space-6);
    transform: translateX(-50%);
    z-index: 2;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dot-ring {
    width: 14px;
    height: 14px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    border: 3px solid var(--color-bg);
    box-shadow: 0 0 0 2px var(--color-primary);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.3s ease;
  }

  .timeline-item:hover .dot-ring {
    transform: scale(1.4);
    box-shadow: 0 0 0 3px var(--color-primary), 0 0 16px rgba(0, 40, 142, 0.25);
  }

  .timeline-card {
    position: relative;
    padding: var(--space-6) var(--space-8);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: translate 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.35s ease,
                border-color 0.35s ease;
  }

  .timeline-card:hover {
    translate: 0 -4px;
    border-color: var(--color-primary);
    box-shadow: 0 12px 40px -8px rgba(0, 40, 142, 0.12),
                0 4px 12px -2px rgba(0, 0, 0, 0.06);
  }

  .card-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .timeline-card:hover .card-accent {
    opacity: 1;
  }

  .period {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-primary);
    background: var(--color-primary-fixed);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-1);
    color: var(--color-text);
    transition: color 0.3s ease;
  }

  .timeline-card:hover h3 {
    color: var(--color-primary);
  }

  .company {
    display: block;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .work-content {
    margin-bottom: var(--space-5);
  }

  .section {
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }

  .section strong {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: var(--space-1);
  }

  .section p {
    margin: 0;
    color: var(--color-text);
  }

  .timeline-left .tech-stack {
    justify-content: flex-end;
  }

  .timeline-left .results {
    text-align: right;
  }

  .timeline-left .results ul {
    padding-left: 0;
    padding-right: var(--space-5);
    list-style-position: inside;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .tech-tag {
    padding: var(--space-1) var(--space-3);
    background: var(--color-secondary-container);
    color: var(--color-on-secondary-container);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tech-tag:hover {
    background: var(--color-primary);
    color: white;
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 4px 12px rgba(0, 40, 142, 0.2);
  }

  .results strong {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .results ul {
    margin-top: var(--space-2);
    padding-left: var(--space-5);
  }

  .results li {
    margin-bottom: var(--space-1);
    color: var(--color-text);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .results li:hover {
    color: var(--color-primary);
  }

  /* ---------- 3D corridor ---------- */
  .experience.is-3d {
    padding-bottom: 0;
  }

  .experience.is-3d .timeline {
    display: none;
  }

  /* Scroll runway: 300vh of scrub travel after the 100vh stage un-pins. */
  .experience.is-3d .runway {
    height: 400vh;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .experience.is-3d .timeline-card {
    width: clamp(340px, 38vw, 560px);
    will-change: transform, opacity;
  }

  /* ---------- Reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .timeline-card:hover {
      translate: none;
    }
    .tech-tag:hover,
    .timeline-item:hover .dot-ring {
      transform: none;
    }
  }

  /* ---------- Tablet: single-column left-aligned ---------- */
  @media (max-width: 768px) {
    .experience {
      padding: var(--space-12) 0;
    }

    h2 {
      font-size: var(--text-3xl);
      margin-bottom: var(--space-8);
    }

    .timeline-line {
      left: 20px;
    }

    .timeline-item {
      display: block;
      padding-left: 52px;
      margin-bottom: var(--space-8);
    }

    .timeline-dot {
      left: 20px;
      top: var(--space-6);
    }

    .timeline-left .timeline-card,
    .timeline-right .timeline-card {
      text-align: left;
    }

    .timeline-left .tech-stack {
      justify-content: flex-start;
    }

    .timeline-left .results {
      text-align: left;
    }

    .timeline-left .results ul {
      padding-left: var(--space-5);
      padding-right: 0;
      list-style-position: outside;
    }

    .timeline-card {
      padding: var(--space-5) var(--space-6);
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 480px) {
    .experience {
      padding: var(--space-8) 0;
    }

    h2 {
      font-size: var(--text-2xl);
    }

    .timeline-line {
      left: 14px;
    }

    .timeline-item {
      padding-left: 40px;
      margin-bottom: var(--space-6);
    }

    .timeline-dot {
      left: 14px;
    }

    .dot-ring {
      width: 12px;
      height: 12px;
    }

    .timeline-card {
      padding: var(--space-4);
    }

    h3 {
      font-size: var(--text-xl);
    }

    .tech-stack {
      gap: var(--space-2);
    }

    .tech-tag {
      font-size: 0.7rem;
      padding: var(--space-1) var(--space-2);
    }

    .results ul {
      padding-left: var(--space-4);
      font-size: var(--text-sm);
    }
  }
</style>
