---
import { getCollection } from 'astro:content';

const workExperience = (await getCollection('projects'))
  .filter((p) => p.data.type === 'work')
  .sort((a, b) => a.data.order - b.data.order);

/* Tokyo Night rotation: one color per run so each job reads as its own
   desk at a glance. */
const accents = ['#7aa2f7', '#bb9af7', '#f7768e', '#7dcfff', '#9ece6a', '#e0af68', '#ff9e64'];

/* Desk anchors inside the isometric office: back row first, then front row.
   Works for any job count; with six jobs the rows are even (3 + 3). */
const layoutDesks = (n: number): [number, number][] => {
  const backCount = Math.ceil(n / 2);
  const frontCount = n - backCount;
  const row = (count: number, y: number, x0: number, step: number) =>
    Array.from({ length: count }, (_, i) => [x0 + i * step, y] as [number, number]);

  return [
    ...row(backCount, 206, 440 - (backCount - 1) * 76, 152),
    ...row(frontCount, 400, 328 + (frontCount === backCount ? 0 : 76), 152),
  ];
};

/* Desk pill: companies drop their legal suffix and the SET note. */
const deskLabel = (company: string) =>
  company
    .replace(/\([^)]*\)/g, '')
    .replace(/(Co\.,?|Ltd\.,?|Company|Co\b)/gi, '')
    .replace(/[^A-Za-z0-9 .&-]/g, '')
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .join(' ');

/* Isometric primitives. cx/cy is the centre of the desk's top face. */
const cube = (cx: number, cy: number, w: number, h: number, v: number) => ({
  top: `M${cx},${cy - h} L${cx + w},${cy} L${cx},${cy + h} L${cx - w},${cy} Z`,
  left: `M${cx - w},${cy} L${cx},${cy + h} L${cx},${cy + h + v} L${cx - w},${cy + v} Z`,
  right: `M${cx + w},${cy} L${cx},${cy + h} L${cx},${cy + h + v} L${cx + w},${cy + v} Z`,
  edge: `M${cx - w},${cy} L${cx},${cy - h} L${cx + w},${cy}`,
  sides: `M${cx - w},${cy} L${cx - w},${cy + v} M${cx},${cy + h} L${cx},${cy + h + v} M${cx + w},${cy} L${cx + w},${cy + v}`,
});

const diamond = (cx: number, cy: number, w: number, h: number, scale = 1) =>
  `M${cx},${cy - h * scale} L${cx + w * scale},${cy} L${cx},${cy + h * scale} L${cx - w * scale},${cy} Z`;

const positions = layoutDesks(workExperience.length);

const runs = workExperience.map((work, index) => {
  const [deskX, deskY] = positions[index] ?? [440, 206];
  const name = deskLabel(work.data.company);

  return {
    zone: `run-${String(index + 1).padStart(2, '0')}`,
    title: work.data.title,
    company: work.data.company,
    name: name || work.data.company,
    shortName: name.split(/\s+/)[0] || work.data.company,
    period: work.data.period,
    datetime: /^\d{4}/.test(work.data.period) ? work.data.period.slice(0, 4) : work.data.period,
    challenge: work.data.challenge,
    solution: work.data.solution,
    tech: work.data.tech,
    results: work.data.results,
    command: `agent run --org "${work.data.company}" --role "${work.data.title}"`,
    accent: accents[index % accents.length],
    runNo: String(index + 1).padStart(2, '0'),
    total: String(workExperience.length).padStart(2, '0'),
    deskX,
    deskY,
    pillY: deskY + 66,
  };
});

const defaultZone = runs[0]?.zone ?? '';

/* One route through the desks in career order (01 -> 06). */
const routePath = positions.map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${x} ${y}`).join(' ');
const lastDesk = positions[positions.length - 1] ?? [440, 206];

/* The packet keyframes follow the same points, so the loop stays in sync
   with the shape of the floor for any job count. The fade at both ends
   hides the jump back to the first desk. */
const packetCss = `
@keyframes office-packet {
  0% { transform: translate(${positions[0]?.[0] ?? 440}px, ${positions[0]?.[1] ?? 206}px); opacity: 0; }
  3% { opacity: 1; }
${positions
  .map(
    ([x, y], i) =>
      `  ${(4 + (i / Math.max(positions.length - 1, 1)) * 91).toFixed(2)}% { transform: translate(${x}px, ${y}px); }`
  )
  .join('\n')}
  95% { opacity: 1; }
  100% { transform: translate(${lastDesk[0]}px, ${lastDesk[1]}px); opacity: 0; }
}
.office-packet {
  animation: office-packet 9s linear infinite both;
}
`;
---

<script is:inline>
  // Runs during parse, before first paint, so the reveal gate is never missed.
  document.documentElement.dataset.trace = 'pending';
</script>

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="container">
    <div class="experience-head">
      <span class="section-label">Career</span>
      <h2 id="experience-title">Work Experience</h2>
      <p class="trace-caption">
        The office floor every run shipped from. Pick a desk to open its trace.
      </p>
    </div>

    <div class="office-stage">
      <div class="scene">
        <svg
          class="scene-svg"
          viewBox="0 0 880 500"
          role="img"
          aria-label="Isometric office floor with one desk per role in the career timeline, newest at the back left. Selecting a desk opens that role's agent trace."
        >
          <defs>
            <linearGradient id="wx-floor" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#1c2030"></stop>
              <stop offset="1" stop-color="#13151f"></stop>
            </linearGradient>
          </defs>

          <path
            d="M440 110 L820 300 L440 490 L60 300 Z"
            fill="url(#wx-floor)"
            stroke="#7aa2f7"
            stroke-opacity="0.28"></path>
          <g stroke="#ffffff" stroke-opacity="0.045">
            <path d="M136 276L516 466"></path><path d="M212 252L592 442"></path><path
              d="M288 229L668 419"
            ></path>
            <path d="M136 324L516 134"></path><path d="M212 347L592 158"></path><path
              d="M288 371L668 181"
            ></path>
          </g>

          <!-- Career route: the path a run walks from first job to current one. -->
          <path
            d={routePath}
            fill="none"
            stroke="#7aa2f7"
            stroke-opacity="0.18"
            stroke-width="1"
            stroke-dasharray="2 6"></path>
          <circle class="office-packet" cx="0" cy="0" r="3" fill="#7aa2f7"></circle>

          {runs.map((run, i) => {
            const body = cube(run.deskX, run.deskY, 40, 20, 12);
            return (
              <g>
                <path
                  d={diamond(run.deskX, run.deskY + 12, 40, 20, 1.12)}
                  fill={run.accent}
                  opacity="0.06"
                />
                <path d={body.left} fill="#1b2030" />
                <path d={body.right} fill="#161a26" />
                <path d={body.top} fill="#262c3e" />
                <rect
                  x={run.deskX - 10}
                  y={run.deskY - 26}
                  width="20"
                  height="16"
                  rx="2"
                  fill="#0e1018"
                  stroke={run.accent}
                  stroke-opacity="0.85"
                />
                <path
                  d={`M${run.deskX} ${run.deskY - 10} L${run.deskX} ${run.deskY - 4}`}
                  stroke={run.accent}
                  stroke-opacity="0.55"
                  stroke-width="1.5"
                />
                <path
                  d={body.edge}
                  fill="none"
                  stroke={run.accent}
                  stroke-opacity="0.85"
                  stroke-width="1.5"
                />
                <path
                  d={body.sides}
                  fill="none"
                  stroke={run.accent}
                  stroke-opacity="0.34"
                  stroke-width="1.2"
                />
                <g transform={`translate(${run.deskX},${run.deskY - 8})`}>
                  <g class="agent" style={`animation-delay:${i * 0.45}s`}>
                    <polygon points="0,-46 5,-38 0,-30 -5,-38" fill={run.accent} opacity="0.9" />
                    <polygon points="0,-46 9,-38 0,-30 -9,-38" fill={run.accent} opacity="0.12" />
                  </g>
                </g>
              </g>
            );
          })}
        </svg>

        {runs.map((run) => {
          /* Hit box: from 44 scene units above the desk down to just under the
             pill, so art and label click as one target. */
          const boxTop = run.deskY - 44;
          const boxHeight = run.pillY + 16 - boxTop;
          return (
            <button
              type="button"
              class:list={['desk', { 'is-active': run.zone === defaultZone }]}
              data-zone={run.zone}
              style={`left:${(run.deskX / 8.8).toFixed(3)}%; top:${((boxTop / 500) * 100).toFixed(3)}%; width:15%; height:${((boxHeight / 500) * 100).toFixed(3)}%; --accent:${run.accent}`}
              aria-controls={`run-panel-${run.zone}`}
              aria-current={run.zone === defaultZone ? 'true' : undefined}
              aria-label={`Open trace: ${run.title} at ${run.company}`}
            >
              <span class="desk-pill">
                <span class="desk-name">{run.name}</span>
                <span class="desk-mini">{run.shortName}</span>
                <span class="desk-period">{run.period}</span>
              </span>
            </button>
          );
        })}
      </div>

      <div class="run-panels" aria-live="polite">
        {runs.map((run) => (
          <article
            id={`run-panel-${run.zone}`}
            class="trace-block work-card"
            data-zone={run.zone}
            style={`--accent:${run.accent}`}
            aria-labelledby={`run-role-${run.zone}`}
            hidden={run.zone !== defaultZone}
          >
            <div class="trace-line trace-cmd" style="--i:0" aria-label={`$ ${run.command}`}>
              <span class="prompt" aria-hidden="true">$</span>
              <span class="cmd" aria-hidden="true" data-cmd data-full={run.command}>{run.command}</span>
              <span class="cursor" aria-hidden="true"></span>
              <span class="run-no" aria-hidden="true">
                <svg class="desk-glyph" viewBox="0 0 12 10" width="12" height="10">
                  <polygon points="6,0 11,3 6,6 1,3" fill="currentColor" opacity="0.9" />
                  <polygon points="1,3 6,6 6,9 1,6" fill="currentColor" opacity="0.45" />
                  <polygon points="11,3 6,6 6,9 11,6" fill="currentColor" opacity="0.28" />
                </svg>
                <b>{run.runNo}</b>/{run.total}
              </span>
            </div>

            <div class="trace-line trace-kv" style="--i:1">
              <span class="k">role</span>
              <h3 id={`run-role-${run.zone}`}>{run.title}</h3>
            </div>

            <div class="trace-line trace-kv" style="--i:2">
              <span class="k">org</span>
              <span class="company">{run.company}</span>
            </div>

            <div class="trace-line trace-kv" style="--i:3">
              <span class="k">period</span>
              <time class="period" datetime={run.datetime}>{run.period}</time>
            </div>

            <div class="trace-line trace-kv" style="--i:4">
              <span class="k">task</span>
              <p class="prose">{run.challenge}</p>
            </div>

            <div class="trace-line trace-kv" style="--i:5">
              <span class="k">impl</span>
              <p class="prose">{run.solution}</p>
            </div>

            <div class="trace-line trace-tool" style="--i:6">
              <span class="arrow" aria-hidden="true">▸</span>
              <span class="tool-label">tool_call({run.tech.length})</span>
            </div>

            <div class="trace-line trace-chips" style="--i:7">
              {run.tech.map((tech) => <span class="tech-tag">{tech}</span>)}
            </div>

            <ul class="results">
              {run.results.map((result, i) => (
                <li class="trace-line" style={`--i:${8 + i}`}>
                  <span class="ok" aria-hidden="true">✔</span>
                  <span>{result}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="run-chips" role="group" aria-label="Jump to a role">
        {runs.map((run) => (
          <button
            type="button"
            class:list={['run-chip', { 'is-active': run.zone === defaultZone }]}
            data-zone={run.zone}
            style={`--accent:${run.accent}`}
            aria-controls={`run-panel-${run.zone}`}
            aria-current={run.zone === defaultZone ? 'true' : undefined}
          >
            <span class="chip-no">{run.runNo}</span>
            <span class="chip-sep" aria-hidden="true">·</span>
            <span class="chip-name">{run.name}</span>
            <span class="chip-tail">
              <span class="chip-sep" aria-hidden="true">·</span>
              <span class="chip-period">{run.period}</span>
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:inline set:html={packetCss}></style>

<script>
  const stage = document.querySelector<HTMLElement>('#experience .office-stage');

  if (stage) {
    const root = document.documentElement;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desks = Array.from(stage.querySelectorAll<HTMLButtonElement>('.desk'));
    const chips = Array.from(stage.querySelectorAll<HTMLButtonElement>('.run-chip'));
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('.work-card'));

    const timers = new Set<number>();
    let observer: IntersectionObserver | null = null;

    const stopTimers = () => {
      timers.forEach((timer) => clearInterval(timer));
      timers.clear();
    };

    const fullCommand = (card: HTMLElement) =>
      card.querySelector<HTMLElement>('[data-cmd]')?.dataset.full ?? '';

    /* No typing left half-finished when the visitor moves to another desk. */
    const settle = () => {
      stopTimers();
      for (const card of cards) {
        const cmd = card.querySelector<HTMLElement>('[data-cmd]');
        if (cmd) cmd.textContent = cmd.dataset.full ?? cmd.textContent;
        card.classList.add('is-done');
      }
    };

    const typeCommand = (card: HTMLElement) => {
      const cmd = card.querySelector<HTMLElement>('[data-cmd]');
      const text = fullCommand(card);
      const finishTyping = () => {
        card.classList.add('is-done');
        if (root.dataset.trace !== 'done') root.dataset.trace = 'done';
      };

      if (!cmd || text.length === 0 || reducedMotion.matches) {
        if (cmd) cmd.textContent = text;
        finishTyping();
        return;
      }

      card.classList.remove('is-done');
      cmd.textContent = '';

      const step = Math.max(6, Math.min(16, 620 / text.length));
      let shown = 0;

      const timer = window.setInterval(() => {
        shown += 1;
        cmd.textContent = text.slice(0, shown);
        if (shown >= text.length) {
          clearInterval(timer);
          timers.delete(timer);
          finishTyping();
        }
      }, step);
      timers.add(timer);
    };

    const reveal = (card: HTMLElement) => {
      /* Restart the line stagger even after the parse-time gate is done. */
      card.classList.remove('is-live');
      void card.offsetWidth;
      card.classList.add('is-live');
      typeCommand(card);
    };

    const activate = (zone: string) => {
      const current = cards.find((card) => card.dataset.zone === zone);
      if (!current) return;

      observer?.disconnect();
      observer = null;
      settle();

      for (const desk of desks) {
        const selected = desk.dataset.zone === zone;
        desk.classList.toggle('is-active', selected);
        if (selected) desk.setAttribute('aria-current', 'true');
        else desk.removeAttribute('aria-current');
      }

      for (const chip of chips) {
        const selected = chip.dataset.zone === zone;
        chip.classList.toggle('is-active', selected);
        if (selected) chip.setAttribute('aria-current', 'true');
        else chip.removeAttribute('aria-current');
      }

      for (const card of cards) {
        card.hidden = card !== current;
      }

      reveal(current);
    };

    const firstCard = cards.find((card) => !card.hidden);

    if (reducedMotion.matches || typeof IntersectionObserver === 'undefined' || !firstCard) {
      if (firstCard) {
        firstCard.classList.add('is-live');
        reveal(firstCard);
      }
      root.dataset.trace = 'done';
    } else {
      observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer?.disconnect();
          observer = null;
          reveal(firstCard);
        },
        { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
      );
      observer.observe(stage);
    }

    stage.addEventListener('click', (event) => {
      const target = (event.target as Element | null)?.closest<HTMLButtonElement>('.desk, .run-chip');
      if (!target || !stage.contains(target)) return;
      const zone = target.dataset.zone;
      if (zone) activate(zone);
    });

    document.addEventListener('astro:before-swap', () => {
      observer?.disconnect();
      stopTimers();
    });
  }
</script>

<style>
  .experience {
    padding: var(--space-16) 0;
  }

  .experience-head {
    max-width: 68ch;
    margin-bottom: var(--space-8);
  }

  h2 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-3);
  }

  .trace-caption {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  /* One dark floor for the whole section: the office and the open trace share
     the same surface, so selecting a desk feels like walking up to it. */
  .office-stage {
    --t-bg: #15161f;
    --t-fg: #c0caf5;
    --t-dim: #565f89;
    --t-muted: #a9b1d6;
    --t-purple: #bb9af7;
    --t-green: #9ece6a;
    --t-chip: #1d202f;

    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 28px;
    padding: clamp(20px, 3vw, 36px);
    border-radius: 16px;
    background: var(--t-bg);
    box-shadow: 0 24px 64px -24px rgba(0, 0, 0, 0.45);
    color: var(--t-fg);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.75;
  }

  /* Scene: viewBox 880x500 shrinks with the column, so the hotspots can be
     placed with plain percentages of that box. */
  .scene {
    position: relative;
    min-width: 0;
    align-self: center;
  }

  .scene-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .agent {
    animation: agent-float 4.5s ease-in-out infinite alternate;
  }

  @keyframes agent-float {
    to {
      transform: translateY(-3px);
    }
  }

  /* Each desk is a real button: a scaled hit box over the art with one
     always-visible pill at its bottom. % sizes track the scene box. */
  .desk {
    position: absolute;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 14px;
    outline: 1px solid transparent;
    outline-offset: 2px;
    background: none;
    color: var(--accent);
    cursor: pointer;
    transform: translateX(-50%);
    transition: outline-color 0.2s ease, box-shadow 0.2s ease;
  }

  .desk-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 3px 8px;
    border-radius: 999px;
    outline: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
    outline-offset: -1px;
    background: rgba(18, 19, 28, 0.88);
    text-align: center;
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .desk-name,
  .desk-mini {
    font-size: 9px;
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--accent);
  }

  .desk-mini {
    display: none;
  }

  .desk-period {
    font-size: 7.5px;
    line-height: 1.3;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--t-dim);
  }

  .desk:hover .desk-pill,
  .desk:focus-visible .desk-pill {
    background: rgba(29, 32, 47, 0.95);
  }

  .desk:hover .desk-period,
  .desk:focus-visible .desk-period,
  .desk.is-active .desk-period {
    color: color-mix(in srgb, var(--accent) 70%, #565f89);
  }

  .desk:hover,
  .desk:focus-visible {
    outline-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .desk.is-active {
    outline-color: color-mix(in srgb, var(--accent) 85%, transparent);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent),
      0 0 22px -6px color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .desk.is-active .desk-pill {
    background: rgba(29, 32, 47, 0.96);
    box-shadow: 0 0 12px -4px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .run-panels {
    min-width: 0;
    align-self: start;
  }

  /* Each run is its own raised sheet: tonal lift on the floor, an accent rail
     in the run's rotation color, and a numbered chip so jobs never blur. */
  .trace-block {
    display: block;
    position: relative;
    background: #191c28;
    border-left: 3px solid var(--accent);
    border-radius: 0 12px 12px 0;
    padding: 16px 22px;
  }

  .work-card[hidden] {
    display: none;
  }

  .work-card:not([hidden]) {
    animation: card-in 0.28s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .trace-line {
    display: block;
  }

  .trace-cmd {
    color: var(--t-fg);
    overflow-wrap: anywhere;
    display: flex;
    align-items: baseline;
    column-gap: 0.75ch;
    min-height: 1.75em;
  }

  .cmd {
    white-space: pre-wrap;
    min-width: 0;
    flex: 1;
  }

  .run-no {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--t-dim);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .desk-glyph {
    color: var(--accent);
  }

  .run-no b {
    color: var(--accent);
    font-weight: 600;
  }

  .prompt {
    color: var(--accent);
    margin-right: 0;
    flex: none;
  }

  .cursor {
    display: none;
    width: 0.6ch;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--t-fg);
    animation: trace-blink 0.9s steps(2, start) infinite;
  }

  :global([data-trace='pending']) .work-card.is-live:not(.is-done) .cursor {
    display: inline-block;
  }

  @keyframes trace-blink {
    50% { opacity: 0; }
  }

  .trace-kv {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    column-gap: 18px;
    align-items: baseline;
  }

  .k {
    color: var(--t-dim);
