---
import { getCollection } from 'astro:content';

const workExperience = (await getCollection('projects'))
  .filter(p => p.data.type === 'work')
  .sort((a, b) => a.data.order - b.data.order);

const runs = workExperience.map((work) => ({
  title: work.data.title,
  company: work.data.company,
  period: work.data.period,
  datetime: /^\d{4}/.test(work.data.period) ? work.data.period.slice(0, 4) : work.data.period,
  challenge: work.data.challenge,
  solution: work.data.solution,
  tech: work.data.tech,
  results: work.data.results,
  command: `agent run --org "${work.data.company}" --role "${work.data.title}"`,
}));
---

<script is:inline>
  // Runs during parse, before first paint, so the reveal gate is never missed.
  document.documentElement.dataset.trace = 'pending';
</script>

<section id="experience" class="experience">
  <div class="container">
    <span class="section-label">Career</span>
    <h2>Work Experience</h2>
    <p class="trace-caption">A run report, newest first. Every line is shipped work.</p>

    <div class="terminal">
      <div class="term-bar">
        <span class="dot dot-red" aria-hidden="true"></span>
        <span class="dot dot-yellow" aria-hidden="true"></span>
        <span class="dot dot-green" aria-hidden="true"></span>
        <span class="term-title">kiwsan@career:~ — agent trace</span>
      </div>

      <div class="term-body">
        {runs.map((run) => (
          <article class="trace-block work-card">
            <div class="trace-line trace-cmd" style="--i:0" aria-label={`$ ${run.command}`}>
              <span class="prompt" aria-hidden="true">$</span>
              <span class="cmd" aria-hidden="true" data-cmd>{run.command}</span>
              <span class="cursor" aria-hidden="true"></span>
            </div>

            <div class="trace-line trace-kv" style="--i:1">
              <span class="k">role</span>
              <h3>{run.title}</h3>
            </div>

            <div class="trace-line trace-kv" style="--i:2">
              <span class="k">org</span>
              <span class="company">{run.company}</span>
            </div>

            <div class="trace-line trace-kv" style="--i:3">
              <span class="k">period</span>
              <time class="period" datetime={run.datetime}>{run.period}</time>
            </div>

            <div class="trace-line trace-kv" style="--i:4">
              <span class="k">task</span>
              <p class="prose">{run.challenge}</p>
            </div>

            <div class="trace-line trace-kv" style="--i:5">
              <span class="k">impl</span>
              <p class="prose">{run.solution}</p>
            </div>

            <div class="trace-line trace-tool" style="--i:6">
              <span class="arrow" aria-hidden="true">▸</span>
              <span class="tool-label">tool_call({run.tech.length})</span>
            </div>

            <div class="trace-line trace-chips" style="--i:7">
              {run.tech.map((tech) => <span class="tech-tag">{tech}</span>)}
            </div>

            <ul class="results">
              {run.results.map((result, i) => (
                <li class="trace-line" style={`--i:${8 + i}`}>
                  <span class="ok" aria-hidden="true">✔</span>
                  <span>{result}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}

        <p class="eof" aria-hidden="true">-- EOF --</p>
      </div>
    </div>
  </div>
</section>

<script>
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('#experience .trace-block'));
  const root = document.documentElement;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const timers = new Set<number>();
  let observer: IntersectionObserver | null = null;
  let pending = blocks.length;

  const cleanup = () => {
    observer?.disconnect();
    observer = null;
    timers.forEach((timer) => clearInterval(timer));
    timers.clear();
    document.removeEventListener('astro:before-swap', cleanup);
  };

  const finish = () => {
    root.dataset.trace = 'done';
    cleanup();
  };

  const typeCommand = (block: HTMLElement) => {
    const cmd = block.querySelector<HTMLElement>('[data-cmd]');
    const done = () => {
      block.classList.add('is-done');
      pending -= 1;
      if (pending <= 0) finish();
    };

    const text = cmd?.textContent ?? '';
    if (!cmd || text.length === 0) {
      done();
      return;
    }

    const step = Math.min(16, 700 / text.length);
    let shown = 0;
    cmd.textContent = '';

    const timer = window.setInterval(() => {
      shown += 1;
      cmd.textContent = text.slice(0, shown);
      if (shown >= text.length) {
        clearInterval(timer);
        timers.delete(timer);
        done();
      }
    }, step);
    timers.add(timer);
  };

  document.addEventListener('astro:before-swap', cleanup);

  if (blocks.length === 0 || reducedMotion.matches || typeof IntersectionObserver === 'undefined') {
    finish();
  } else {
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const block = entry.target as HTMLElement;
          observer?.unobserve(block);
          block.classList.add('is-live');
          typeCommand(block);
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );
    blocks.forEach((block) => observer?.observe(block));
  }
</script>

<style>
  .experience {
    padding: var(--space-16) 0;
  }

  h2 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-3);
  }

  .trace-caption {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0 0 var(--space-8);
  }

  /* One dark terminal on both themes: a deliberate contrast object in light
     mode, a natural Tokyo Night surface in dark mode. */
  .terminal {
    --t-bg: #15161f;
    --t-fg: #c0caf5;
    --t-dim: #565f89;
    --t-muted: #a9b1d6;
    --t-blue: #7aa2f7;
    --t-purple: #bb9af7;
    --t-green: #9ece6a;
    --t-chip: #1d202f;

    position: relative;
    overflow: hidden;
    border-radius: 14px;
    background: var(--t-bg);
    box-shadow: 0 24px 64px -24px rgba(0, 0, 0, 0.45);
    color: var(--t-fg);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.75;
  }

  .terminal::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: repeating-linear-gradient(
      rgba(255, 255, 255, 0.015) 0 1px,
      transparent 1px 3px
    );
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px clamp(20px, 4vw, 40px) 0;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    flex: none;
  }

  .dot-red { background: #f7768e; }
  .dot-yellow { background: #e0af68; }
  .dot-green { background: #9ece6a; }

  .term-title {
    margin-left: auto;
    color: var(--t-dim);
    font-size: 12px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .term-body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 34px;
    padding: clamp(20px, 4vw, 40px);
  }

  .trace-block {
    display: block;
  }

  .trace-line {
    display: block;
  }

  .trace-cmd {
    color: var(--t-fg);
    overflow-wrap: anywhere;
  }

  .prompt {
    color: var(--t-blue);
    margin-right: 0.75ch;
  }

  .cmd {
    white-space: pre-wrap;
  }

  .cursor {
    display: none;
    width: 0.6ch;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--t-fg);
    animation: trace-blink 0.9s steps(2, start) infinite;
  }

  :global([data-trace='pending']) .trace-block.is-live:not(.is-done) .cursor {
    display: inline-block;
  }

  @keyframes trace-blink {
    50% { opacity: 0; }
  }

  .trace-kv {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    column-gap: 18px;
    align-items: baseline;
  }

  .k {
    color: var(--t-dim);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h3 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: 0;
    color: var(--t-fg);
  }

  .company,
  .period {
    color: var(--t-fg);
  }

  .prose {
    margin: 0;
    max-width: 68ch;
    color: var(--t-muted);
  }

  .trace-tool {
    display: flex;
    align-items: baseline;
    gap: 0.75ch;
    margin-top: 4px;
  }

  .arrow {
    color: var(--t-purple);
  }

  .tool-label {
    color: var(--t-dim);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .trace-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-left: 2ch;
  }

  .tech-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--t-chip);
    color: var(--t-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s ease;
  }

  .tech-tag:hover {
    transform: translateY(-2px);
    color: var(--t-purple);
  }

  .results {
    list-style: none;
    margin: 6px 0 0;
    padding: 0 0 0 2ch;
  }

  .results li {
    display: flex;
    align-items: baseline;
    gap: 0.75ch;
    color: var(--t-muted);
  }

  .ok {
    color: var(--t-green);
  }

  .eof {
    margin: 0;
    color: var(--t-dim);
    font-size: 12px;
  }

  /* Reveal gate: only while the inline script says 'pending'. No JS leaves the
     attribute unset, so the whole trace stays visible. */
  :global([data-trace='pending']) .trace-line {
    opacity: 0;
    transform: translateY(6px);
  }

  :global([data-trace='pending']) .trace-block.is-live .trace-line {
    opacity: 1;
    transform: none;
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(120ms + var(--i) * 70ms);
  }

  @keyframes trace-pop {
    from { transform: scale(0.86); }
    to { transform: scale(1); }
  }

  :global([data-trace='pending']) .trace-block.is-live .results li {
    animation: trace-pop 0.36s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(120ms + var(--i) * 70ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-tag:hover {
      transform: none;
    }

    /* Belt and suspenders: even if the script never runs, reduced motion
       users see the full trace. */
    :global([data-trace='pending']) .trace-line {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .experience {
      padding: var(--space-12) 0;
    }

    h2 {
      font-size: var(--text-3xl);
    }

    .terminal {
      font-size: 12px;
    }

    .trace-kv {
      grid-template-columns: 62px minmax(0, 1fr);
      column-gap: 12px;
    }

    h3 {
      font-size: 13px;
    }

    .term-title {
      font-size: 11px;
    }
  }
</style>
