---
import { getCollection, type CollectionEntry } from 'astro:content';

type WorkEntry = CollectionEntry<'projects'> & {
  data: { type: 'work' };
};

const workExperience = (await getCollection('projects'))
  .filter((p): p is WorkEntry => p.data.type === 'work')
  .sort((a, b) => a.data.order - b.data.order);

/* Tokyo Night rotation: one color per run so each job reads as its own
   office at a glance. */
const accents = ['#7aa2f7', '#bb9af7', '#f7768e', '#7dcfff', '#9ece6a', '#e0af68', '#ff9e64'];

/* Office pill: companies drop their legal suffix and the SET note. */
const officeLabel = (company: string) =>
  company
    .replace(/\([^)]*\)/g, '')
    .replace(/(Co\.,?|Ltd\.,?|Company|Co\b)/gi, '')
    .replace(/[^A-Za-z0-9 .&-]/g, '')
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .join(' ');

/* Isometric primitives for one office block. cx/cy is the centre of the top
   face; every tower sits on a shared base line inside a 200x150 viewBox so the
   cluster stays centred on the timeline spine. */
const cube = (cx: number, cy: number, w: number, h: number, v: number) => ({
  top: `M${cx},${cy - h} L${cx + w},${cy} L${cx},${cy + h} L${cx - w},${cy} Z`,
  left: `M${cx - w},${cy} L${cx},${cy + h} L${cx},${cy + h + v} L${cx - w},${cy + v} Z`,
  right: `M${cx + w},${cy} L${cx},${cy + h} L${cx},${cy + h + v} L${cx + w},${cy + v} Z`,
});

const BASE_Y = 116;
const GROUND_Y = 144;
const CENTER_X = 100;

interface TowerSpec {
  cx: number;
  halfWidth: number;
  height: number;
  roof?: 'setback' | 'antenna';
}

interface OfficeProfile {
  pad: number;
  floors: number;
  label: string;
  towers: TowerSpec[];
}

/* Company size is editorial data, so the drawing grammar lives in one table:
   small is one low block, enterprise is a three-tower campus. */
const OFFICE_PROFILES = {
  small: {
    pad: 28,
    floors: 6,
    label: 'SMALL',
    towers: [{ cx: 100, halfWidth: 17, height: 38 }],
  },
  medium: {
    pad: 38,
    floors: 10,
    label: 'MEDIUM',
    towers: [
      { cx: 84, halfWidth: 15, height: 32 },
      { cx: 118, halfWidth: 19, height: 50, roof: 'setback' },
    ],
  },
  large: {
    pad: 46,
    floors: 14,
    label: 'LARGE',
    towers: [
      { cx: 68, halfWidth: 14, height: 34 },
      { cx: 100, halfWidth: 18, height: 56 },
      { cx: 132, halfWidth: 14, height: 42 },
    ],
  },
  enterprise: {
    pad: 48,
    floors: 20,
    label: 'ENTERPRISE',
    towers: [
      { cx: 64, halfWidth: 13, height: 36 },
      { cx: 100, halfWidth: 22, height: 66, roof: 'antenna' },
      { cx: 136, halfWidth: 13, height: 46 },
    ],
  },
} satisfies Record<string, OfficeProfile>;

/* Windows follow each wall's isometric basis. One path holds every pane on a
   face, so a three-tower campus stays cheap to render. */
const faceWindows = (
  cx: number,
  topY: number,
  halfWidth: number,
  depth: number,
  height: number,
  side: 'left' | 'right'
) => {
  const rows = Math.min(4, Math.max(2, Math.round(height / 16)));
  const cols = Math.min(3, Math.max(2, Math.round(halfWidth / 8)));
  const uStart = 0.13;
  const uSpan = 0.74;
  const vStart = 0.11;
  const vSpan = 0.78;
  const cellW = uSpan / cols;
  const cellH = vSpan / rows;
  const winW = cellW * 0.56;
  const winH = cellH * 0.46;
  const point = (u: number, v: number) =>
    side === 'left'
      ? ([cx - halfWidth + u * halfWidth, topY + u * depth + v * height] as const)
      : ([cx + u * halfWidth, topY + depth - u * depth + v * height] as const);
  const panes: string[] = [];
  const lit: string[] = [];
  const offset = side === 'left' ? 0 : 2;

  for (let row = 0; row < rows; row += 1) {
    for (let col = 0; col < cols; col += 1) {
      const u0 = uStart + col * cellW + (cellW - winW) / 2;
      const u1 = u0 + winW;
      const v0 = vStart + row * cellH + (cellH - winH) / 2;
      const v1 = v0 + winH;
      const [x0, y0] = point(u0, v0);
      const [x1, y1] = point(u1, v0);
      const [x2, y2] = point(u1, v1);
      const [x3, y3] = point(u0, v1);
      const pane = `M${x0.toFixed(1)} ${y0.toFixed(1)} L${x1.toFixed(1)} ${y1.toFixed(1)} L${x2.toFixed(1)} ${y2.toFixed(1)} L${x3.toFixed(1)} ${y3.toFixed(1)} Z`;
      panes.push(pane);
      if ((row + col + offset) % 3 === 0) lit.push(pane);
    }
  }

  return { panes: panes.join(' '), lit: lit.join(' ') };
};

const buildTower = (spec: TowerSpec) => {
  const depth = spec.halfWidth * 0.5;
  const topY = BASE_Y - spec.height;
  const body = cube(spec.cx, topY, spec.halfWidth, depth, spec.height);
  const setbackWidth = spec.halfWidth * 0.56;
  const setback =
    spec.roof === 'setback'
      ? cube(spec.cx, topY - 6, setbackWidth, setbackWidth * 0.5, 6)
      : null;
  const antenna =
    spec.roof === 'antenna'
      ? { x: spec.cx, base: topY - depth - 1, tip: topY - depth - 12 }
      : null;

  return {
    ...spec,
    topY,
    depth,
    body,
    setback,
    antenna,
    windows: {
      left: faceWindows(spec.cx, topY, spec.halfWidth, depth, spec.height, 'left'),
      right: faceWindows(spec.cx, topY, spec.halfWidth, depth, spec.height, 'right'),
    },
  };
};

/* Display-only: the run periods read better with a real dash on the rail. */
const railPeriod = (period: string) => period.replace(/\s+-\s+/g, ' — ');

const runs = workExperience.map((work, index) => {
  const name = officeLabel(work.data.company);
  const profile = OFFICE_PROFILES[work.data.companySize];
  const towers = profile.towers.map(buildTower);
  const tallest = towers.reduce((a, b) => (a.height > b.height ? a : b));

  return {
    zone: `run-${String(index + 1).padStart(2, '0')}`,
    title: work.data.title,
    company: work.data.company,
    name: name || work.data.company,
    period: work.data.period,
    railPeriod: railPeriod(work.data.period),
    datetime: /^\d{4}/.test(work.data.period) ? work.data.period.slice(0, 4) : work.data.period,
    challenge: work.data.challenge,
    solution: work.data.solution,
    tech: work.data.tech,
    results: work.data.results,
    command: `career log --org "${work.data.company}" --role "${work.data.title}"`,
    accent: accents[index % accents.length],
    runNo: String(index + 1).padStart(2, '0'),
    total: String(workExperience.length).padStart(2, '0'),
    sizeLabel: profile.label,
    floors: profile.floors,
    pad: cube(CENTER_X, BASE_Y + 2, profile.pad, profile.pad * 0.5, 3),
    towers,
    peakTop: tallest.topY - tallest.depth,
  };
});

const onlineCount = String(workExperience.length).padStart(2, '0');
const firstYear = workExperience[workExperience.length - 1]?.data.period.match(/\d{4}/)?.[0] ?? '';
---

<script is:inline>
  // Runs during parse, before first paint, so the reveal gate is never missed.
  document.documentElement.dataset.trace = 'pending';
</script>

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="container">
    <div class="experience-head">
      <span class="section-label">Career</span>
      <h2 id="experience-title">Work Experience</h2>
      <p class="trace-caption">
        Every shipped run, newest to oldest. The office floor scrolls with the story.
      </p>
    </div>

    <div class="office-stage">
      <div class="scene-meta" aria-hidden="true">
        <span class="meta-line">career floor</span>
        <span class="meta-chip"><i class="meta-dot"></i>{onlineCount} roles · {firstYear} — now</span>
      </div>

      <div class="timeline">
        <div class="timeline-spine" aria-hidden="true"></div>
        <div class="timeline-packet" aria-hidden="true"></div>

        {runs.map((run) => (
          <div class="tl-row" data-zone={run.zone} style={`--accent:${run.accent}`}>
            <div class="tl-rail">
              <span class="tl-period">{run.railPeriod}</span>

              <svg class="tl-skyline" viewBox="0 0 200 150" aria-hidden="true">
                <defs>
                  <pattern id={`bp-grid-${run.zone}`} width="10" height="10" patternUnits="userSpaceOnUse">
                    <circle class="bp-dot" cx="1" cy="1" r="0.8" />
                  </pattern>
                </defs>
                <rect class="skyline-bg" width="200" height="150" />
                <rect class="bp-grid" x="40" y="48" width="120" height="92" rx="4" fill={`url(#bp-grid-${run.zone})`} />
                <g class="bp-cross">
                  <path d="M100 48 L100 56 M96 52 L104 52" />
                  <path d="M44 64 L44 72 M40 68 L48 68" />
                  <path d="M156 64 L156 72 M152 68 L160 68" />
                  <path d="M100 132 L100 140 M96 136 L104 136" />
                </g>
                <path class="accent-stroke bp-dim" d="M36 20 L164 20 M36 16 L36 24 M164 16 L164 24" />
                <text class="bp-dim-label" x="100" y="14" text-anchor="middle">{run.sizeLabel}</text>
                <path
                  class="accent-stroke bp-dim"
                  d={`M178 ${run.peakTop} L178 ${BASE_Y} M174 ${run.peakTop} L182 ${run.peakTop} M174 ${BASE_Y} L182 ${BASE_Y}`}
                />
                <text class="bp-dim-label" x="184" y={(run.peakTop + BASE_Y) / 2 + 2}>{run.floors}F</text>
                <path class="accent-stroke bp-floor" d={`M28 ${GROUND_Y} L172 ${GROUND_Y}`} />
                <path
                  class="accent-stroke bp-tick"
                  d={`M50 ${GROUND_Y - 4} L50 ${GROUND_Y + 4} M80 ${GROUND_Y - 4} L80 ${GROUND_Y + 4} M110 ${GROUND_Y - 4} L110 ${GROUND_Y + 4} M140 ${GROUND_Y - 4} L140 ${GROUND_Y + 4}`}
                />
                <path class="pad-left" d={run.pad.left} />
                <path class="pad-right" d={run.pad.right} />
                <path class="pad-top accent-fill" d={run.pad.top} />
                {run.towers.map((tower) => (
                  <g class="tower">
                    <path class="tower-left" d={tower.body.left} />
                    <path class="tower-right" d={tower.body.right} />
                    <path class="tower-top" d={tower.body.top} />
                    <path class="tower-win" d={tower.windows.left.panes} />
                    <path class="tower-win" d={tower.windows.right.panes} />
                    <path class="tower-win-lit" d={tower.windows.left.lit} />
                    <path class="tower-win-lit" d={tower.windows.right.lit} />
                    {tower.setback && (
                      <g class="tower-setback">
                        <path class="tower-left" d={tower.setback.left} />
                        <path class="tower-right" d={tower.setback.right} />
                        <path class="tower-top" d={tower.setback.top} />
                      </g>
                    )}
                    {tower.antenna && (
                      <g class="antenna">
                        <path d={`M${tower.antenna.x} ${tower.antenna.base} L${tower.antenna.x} ${tower.antenna.tip}`} />
                        <circle cx={tower.antenna.x} cy={tower.antenna.tip} r="1.6" />
                      </g>
                    )}
                  </g>
                ))}
              </svg>

              <span class="tl-node" aria-hidden="true"></span>

              <span class="tl-pill office-pill">
                <span class="office-name">{run.name}</span>
                <span class="office-period">{run.period}</span>
              </span>
            </div>

            <article
              class="trace-block work-card"
              data-zone={run.zone}
              style={`--accent:${run.accent}`}
              aria-labelledby={`run-role-${run.zone}`}
            >
              <div class="trace-line trace-cmd" style="--i:0" aria-label={`$ ${run.command}`}>
                <span class="prompt" aria-hidden="true">$</span>
                <span class="cmd" aria-hidden="true" data-cmd data-full={run.command}>{run.command}</span>
                <span class="cursor" aria-hidden="true"></span>
                <span class="run-no" aria-hidden="true">
                  <svg class="tower-glyph" viewBox="0 0 12 10" width="12" height="10">
                    <polygon points="6,0 11,3 6,6 1,3" fill="currentColor" opacity="0.9" />
                    <polygon points="1,3 6,6 6,9 1,6" fill="currentColor" opacity="0.45" />
                    <polygon points="11,3 6,6 6,9 11,6" fill="currentColor" opacity="0.28" />
                  </svg>
                  <b>{run.runNo}</b>/{run.total}
                </span>
              </div>

              <div class="trace-line trace-kv" style="--i:1">
                <span class="k">role</span>
                <h3 id={`run-role-${run.zone}`}>{run.title}</h3>
              </div>

              <div class="trace-line trace-kv" style="--i:2">
                <span class="k">org</span>
                <span class="company">{run.company}</span>
              </div>

              <div class="trace-line trace-kv" style="--i:3">
                <span class="k">period</span>
                <time class="period" datetime={run.datetime}>{run.period}</time>
              </div>

              <div class="trace-line trace-kv" style="--i:4">
                <span class="k">task</span>
                <p class="prose">{run.challenge}</p>
              </div>

              <div class="trace-line trace-kv" style="--i:5">
                <span class="k">impl</span>
                <p class="prose">{run.solution}</p>
              </div>

              <div class="trace-line trace-tool" style="--i:6">
                <span class="arrow" aria-hidden="true">▸</span>
                <span class="tool-label">tool_call({run.tech.length})</span>
              </div>

              <div class="trace-line trace-chips" style="--i:7">
                {run.tech.map((tech) => <span class="tech-tag">{tech}</span>)}
              </div>

              <ul class="results">
                {run.results.map((result, i) => (
                  <li class="trace-line" style={`--i:${8 + i}`}>
                    <span class="ok" aria-hidden="true">✔</span>
                    <span>{result}</span>
                  </li>
                ))}
              </ul>
            </article>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('#experience .office-stage');

  if (stage) {
    const root = document.documentElement;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('.work-card'));
    const timeline = stage.querySelector<HTMLElement>('.timeline');
    const spine = stage.querySelector<HTMLElement>('.timeline-spine');
    const lastNode = stage.querySelector<HTMLElement>('.tl-row:last-child .tl-node');
    const timers = new Map<HTMLElement, number>();
    let observer: IntersectionObserver | null = null;

    /* Trim the spine to the last node (CSS stretches it to the floor when
       this never runs, e.g. with JS off). */
    const sizeSpine = () => {
      if (!timeline || !spine || !lastNode) return;
      const box = timeline.getBoundingClientRect();
      const node = lastNode.getBoundingClientRect();
      if (box.height === 0 || node.height === 0) return;
      timeline.style.setProperty('--spine-h', `${Math.max(0, node.top + node.height / 2 - box.top - 8)}px`);
    };

    sizeSpine();
    window.addEventListener('resize', sizeSpine);
    document.fonts?.ready.then(sizeSpine);

    if (typeof ResizeObserver !== 'undefined' && timeline) {
      new ResizeObserver(sizeSpine).observe(timeline);
    }

    const commandOf = (card: HTMLElement) => card.querySelector<HTMLElement>('[data-cmd]');

    /* Type once per card, capped at 620ms however long the command is. */
    const typeCommand = (card: HTMLElement) => {
      const cmd = commandOf(card);
      const text = cmd?.dataset.full ?? '';

      if (!cmd || text.length === 0) {
        card.classList.add('is-done');
        return;
      }

      cmd.textContent = '';
      card.classList.remove('is-done');

      const step = Math.max(6, Math.min(16, 620 / text.length));
      let shown = 0;

      const timer = window.setInterval(() => {
        shown += 1;
        cmd.textContent = text.slice(0, shown);
        if (shown >= text.length) {
          clearInterval(timer);
          timers.delete(card);
          card.classList.add('is-done');
        }
      }, step);
      timers.set(card, timer);
    };

    /* Finish any typing in flight so a card never gets left half-written. */
    const settle = (card: HTMLElement) => {
      const timer = timers.get(card);
      if (timer !== undefined) {
        clearInterval(timer);
        timers.delete(card);
      }
      const cmd = commandOf(card);
      if (cmd) cmd.textContent = cmd.dataset.full ?? '';
      card.classList.add('is-done');
    };

    const reveal = (card: HTMLElement) => {
      if (card.dataset.revealed === 'true') return;
      card.dataset.revealed = 'true';
      card.classList.add('is-live');
      typeCommand(card);
    };

    /* No motion budget or no observer: everything is already live. */
    const revealAll = () => {
      for (const card of cards) {
        card.classList.add('is-live');
        settle(card);
      }
      root.dataset.trace = 'done';
    };

    /* If a visitor jumps past runs, mark the ones above the landing card as
       already read so their text never stays hidden. Runs below the landing
       card keep waiting for their own intersection. */
    const passThrough = (landed: HTMLElement) => {
      const index = cards.indexOf(landed);
      if (index < 1) return;

      for (let i = 0; i < index; i += 1) {
        const card = cards[i];
        if (card.dataset.revealed === 'true') continue;
        card.dataset.revealed = 'true';
        card.classList.add('is-live');
        settle(card);
      }
    };

    if (reducedMotion.matches || typeof IntersectionObserver === 'undefined' || cards.length === 0) {
      revealAll();
    } else {
      observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const card = entry.target as HTMLElement;
            observer?.unobserve(card);
            passThrough(card);
            reveal(card);
          }
        },
        { rootMargin: '0px 0px -18% 0px', threshold: 0.05 }
      );

      for (const card of cards) observer.observe(card);

      window.addEventListener('pagehide', () => {
        for (const card of cards) settle(card);
      });
    }

    reducedMotion.addEventListener('change', (event) => {
      if (!event.matches) return;
      observer?.disconnect();
      observer = null;
      revealAll();
    });

    document.addEventListener('astro:before-swap', () => {
      observer?.disconnect();
      observer = null;
      timers.forEach((timer) => clearInterval(timer));
      timers.clear();
    });
  }
</script>

<style>
  .experience {
    padding: var(--space-16) 0;
  }

  .experience-head {
    max-width: 68ch;
    margin-bottom: var(--space-8);
  }

  h2 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-3);
  }

  .trace-caption {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  /* One floor holds the whole run history: rail on the left, trace on the
     right, both scrolling down the career. Light turns the floor into paper
     and the trace into raised sheets; dark keeps the Tokyo Night terminal. */
  .office-stage {
    --t-bg: #f2f4f6;
    /* Text follows the main theme tokens (light + dark + no-JS) so the
       stage can never drift out of sync with the rest of the page. */
    --t-fg: var(--color-text);
    --t-dim: var(--color-on-secondary-container);
    --t-muted: var(--color-text-muted);
    --t-purple: #6d3fc0;
    --t-green: #256b2b;
    --t-chip: #e6ebf2;
    --t-card: #ffffff;
    --t-raised: #ffffff;
    --t-grid: color-mix(in srgb, var(--color-text-muted) 22%, transparent);
    --tower-top: #fbfcfe;
    --tower-left: #d5deea;
    --tower-right: #c2cedf;
    --t-stage-shadow: 0 28px 64px -32px rgba(16, 24, 40, 0.18);
    --t-raised-shadow: 0 8px 24px -12px rgba(16, 24, 40, 0.18);
    --t-spine: linear-gradient(
      180deg,
      #3d5a9e 0%,
      #6b5b9e 52%,
      rgba(160, 90, 106, 0.55) 88%,
      rgba(160, 90, 106, 0) 100%
    );
    --t-spine-opacity: 0.6;
    --t-packet: #3d5a9e;
    --t-packet-shadow:
      0 0 10px 2px rgba(61, 90, 158, 0.35),
      0 0 26px 6px rgba(61, 90, 158, 0.12);
    --t-node-weight: 88%;
    --t-node-ring: 30%;
    --t-node-glow: 40%;
    --t-pill-shadow-strength: 35%;
    --t-dot-glow: 35%;

    padding: clamp(20px, 3vw, 36px);
    border-radius: 16px;
    background: var(--t-bg);
    box-shadow: var(--t-stage-shadow);
    color: var(--t-fg);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.75;
  }

  :global([data-theme="dark"]) .office-stage {
    --t-bg: #15161f;
    --t-purple: #bb9af7;
    --t-green: #9ece6a;
    --t-chip: #1d202f;
    --t-card: #191c28;
    --t-raised: #1d202f;
    --tower-top: #262c3e;
    --tower-left: #1b2030;
    --tower-right: #161a26;
    --t-stage-shadow: 0 24px 64px -24px rgba(0, 0, 0, 0.45);
    --t-raised-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.5);
    --t-spine: linear-gradient(
      180deg,
      #7aa2f7 0%,
      #bb9af7 52%,
      rgba(247, 118, 142, 0.55) 88%,
      rgba(247, 118, 142, 0) 100%
    );
    --t-spine-opacity: 0.35;
    --t-packet: #7aa2f7;
    --t-packet-shadow:
      0 0 10px 2px rgba(122, 162, 247, 0.5),
      0 0 26px 6px rgba(122, 162, 247, 0.18);
    --t-node-weight: 65%;
    --t-node-ring: 26%;
    --t-node-glow: 55%;
    --t-pill-shadow-strength: 65%;
    --t-dot-glow: 80%;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .office-stage {
      --t-bg: #15161f;
      --t-purple: #bb9af7;
      --t-green: #9ece6a;
      --t-chip: #1d202f;
      --t-card: #191c28;
      --t-raised: #1d202f;
      --tower-top: #262c3e;
      --tower-left: #1b2030;
      --tower-right: #161a26;
      --t-stage-shadow: 0 24px 64px -24px rgba(0, 0, 0, 0.45);
      --t-raised-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.5);
