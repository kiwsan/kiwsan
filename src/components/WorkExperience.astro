---
import { getCollection, type CollectionEntry } from 'astro:content';
import { GROUND_Y, buildOfficeScene } from '../lib/experience/office';
import { officeLabel, railPeriod } from '../lib/experience/labels';

type WorkEntry = CollectionEntry<'projects'> & {
  data: { type: 'work' };
};

const workExperience = (await getCollection('projects'))
  .filter((p): p is WorkEntry => p.data.type === 'work')
  .sort((a, b) => a.data.order - b.data.order);

const runs = workExperience.map((work, index) => {
  const name = officeLabel(work.data.company);

  return {
    zone: `run-${String(index + 1).padStart(2, '0')}`,
    title: work.data.title,
    company: work.data.company,
    name: name || work.data.company,
    period: work.data.period,
    railPeriod: railPeriod(work.data.period),
    datetime: /^\d{4}/.test(work.data.period) ? work.data.period.slice(0, 4) : work.data.period,
    challenge: work.data.challenge,
    solution: work.data.solution,
    tech: work.data.tech,
    results: work.data.results,
    runNo: String(index + 1).padStart(2, '0'),
    total: String(workExperience.length).padStart(2, '0'),
    office: buildOfficeScene(work.data.companySize),
  };
});
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="container">
    <div class="experience-head">
      <span class="section-label">Career</span>
      <h2 id="experience-title">Work Experience</h2>
      <p class="trace-caption">
        Every shipped run, newest to oldest. The office floor scrolls with the story.
      </p>
    </div>

    <div class="runs">
      {runs.map((run) => (
        <article class="run" aria-labelledby={`run-role-${run.zone}`}>
          <div class="run-rail">
            <span class="run-index">
              <b>{run.runNo}</b> / {run.total}
            </span>
            <span class="run-period">{run.railPeriod}</span>
            <svg class="run-skyline" viewBox="0 0 200 150" aria-hidden="true">
              {run.office.towers.map((tower) => (
                <g class="tower">
                  <path class="tower-left" d={tower.body.left} />
                  <path class="tower-right" d={tower.body.right} />
                  <path class="tower-top" d={tower.body.top} />
                  <path class="tower-win" d={tower.windows.left.panes} />
                  <path class="tower-win" d={tower.windows.right.panes} />
                  <path class="tower-win tower-win-lit" d={tower.windows.left.lit} />
                  <path class="tower-win tower-win-lit" d={tower.windows.right.lit} />
                  {tower.setback && (
                    <g class="tower-setback">
                      <path class="tower-left" d={tower.setback.left} />
                      <path class="tower-right" d={tower.setback.right} />
                      <path class="tower-top" d={tower.setback.top} />
                    </g>
                  )}
                  {tower.antenna && (
                    <g class="antenna">
                      <path
                        d={`M${tower.antenna.x} ${tower.antenna.base} L${tower.antenna.x} ${tower.antenna.tip}`}
                      />
                      <circle cx={tower.antenna.x} cy={tower.antenna.tip} r="1.6" />
                    </g>
                  )}
                </g>
              ))}
              <path class="run-ground" d={`M28 ${GROUND_Y} L172 ${GROUND_Y}`} />
            </svg>
            <span class="run-office">{run.name}</span>
            <span class="run-office-period">{run.period}</span>
            <span class="run-scale">
              {run.office.sizeLabel} · {run.office.floors}F
            </span>
          </div>

          <div class="run-body">
            <div class="field">
              <span class="field-label">role</span>
              <h3 id={`run-role-${run.zone}`}>{run.title}</h3>
            </div>
            <div class="field">
              <span class="field-label">org</span>
              <span class="field-value">{run.company}</span>
            </div>
            <div class="field">
              <span class="field-label">period</span>
              <time class="field-value" datetime={run.datetime}>
                {run.period}
              </time>
            </div>
            <div class="field">
              <span class="field-label">task</span>
              <p class="field-value">{run.challenge}</p>
            </div>
            <div class="field">
              <span class="field-label">impl</span>
              <p class="field-value">{run.solution}</p>
            </div>
            <div class="field">
              <span class="field-label" aria-hidden="true"></span>
              <div class="tools">
                {run.tech.map((tech) => (
                  <span class="tool">{tech}</span>
                ))}
              </div>
            </div>
            <div class="field">
              <span class="field-label" aria-hidden="true"></span>
              <ul class="results">
                {run.results.map((result) => (
                  <li>{result}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience {
    padding: clamp(4rem, 8vw, 6rem) 0;
    border-top: 1px solid var(--color-rule);
  }

  .experience-head {
    max-width: 68ch;
    margin-bottom: var(--space-8);
  }

  h2 {
    margin-bottom: var(--space-3);
    font-size: var(--text-section);
  }

  .trace-caption {
    max-width: 62ch;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  .runs {
    border-top: 1px solid var(--color-rule);
  }

  .run {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--space-8);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .run-rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .run-index {
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-muted);
  }

  .run-index b {
    font-weight: 600;
    color: var(--color-ink);
  }

  .run-skyline {
    display: block;
    width: 100%;
    max-width: 9rem;
    height: auto;
    padding: var(--space-1);
    background: var(--color-plate);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-control);
  }

  .run-period,
  .run-office,
  .run-office-period,
  .run-scale {
    font-size: var(--text-small);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .run-period,
  .run-office-period,
  .run-scale {
    color: var(--color-ink-muted);
  }

  .run-office {
    color: var(--color-ink);
  }

  .run-body {
    min-width: 0;
  }

  .field {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-1) 0;
  }

  .field-label {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
    text-transform: capitalize;
  }

  .field h3 {
    font-family: var(--font-body);
    font-size: var(--text-lede);
    font-weight: 600;
    line-height: 1.4;
  }

  .field-value {
    max-width: 62ch;
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tool {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-inline);
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .results {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    list-style: none;
  }

  .results li {
    position: relative;
    max-width: 62ch;
    padding-left: 1rem;
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .results li::before {
    content: '';
    position: absolute;
    top: 0.75em;
    left: 0;
    width: 0.5rem;
    height: 1px;
    background: var(--color-ink-muted);
  }

  .tower-left {
    fill: var(--color-plate);
    stroke: var(--color-ink);
    stroke-width: 0.6;
  }

  .tower-right {
    fill: color-mix(in srgb, var(--color-ink) 8%, var(--color-page));
    stroke: var(--color-ink);
    stroke-width: 0.6;
  }

  .tower-top {
    fill: var(--color-page);
    stroke: var(--color-ink);
    stroke-width: 0.8;
  }

  .tower-win {
    fill: var(--color-ink-muted);
    opacity: 0.28;
  }

  .tower-win-lit {
    fill: var(--color-ink);
    opacity: 0.6;
  }

  .antenna path {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.2;
  }

  .antenna circle {
    fill: var(--color-ink);
  }

  .run-ground {
    fill: none;
    stroke: var(--color-rule);
    stroke-width: 1;
  }

  @media (max-width: 1023px) {
    .run {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-6) 0;
    }

    .run-rail {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-2) var(--space-4);
    }

    .run-skyline {
      align-self: flex-start;
      width: 6rem;
      max-width: 6rem;
    }
  }

  @media (max-width: 768px) {
    .experience {
      padding: clamp(3rem, 9vw, 4rem) 0;
    }

    .field {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }

    .field-label {
      margin-top: var(--space-2);
    }

    .field-label:empty {
      margin-top: 0;
    }
  }
</style>
