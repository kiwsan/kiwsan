---
import { SITE } from '../lib/site';

const buildVersion = import.meta.env.PUBLIC_BUILD_VERSION || 'dev';
---

<footer class="footer">
  <div class="container">
    <div class="footer-referrals">
      <p>Deploy your next app in seconds. Get $100 in cloud credits:</p>
      <a
        href="https://www.digitalocean.com/?refcode=0e2c3672d1dc&utm_campaign=Referral_Invite&utm_medium=Referral_Program&utm_source=badge"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="/images/digitalocean-badge.svg"
          alt="DigitalOcean Referral Badge - Get $100 Cloud Credits"
          width="200"
          height="65"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p>Premium web hosting with 20% off:</p>
      <a
        href="https://www.hostinger.com/th?REFERRALCODE=GWYKIWSANQZC"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="/images/hostinger-black.svg"
          alt="Hostinger Referral Badge - Premium Web Hosting 20% Off"
          width="200"
          height="65"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p>If this site helped you, you can support it:</p>
      <a
        class="bmc-button"
        href="https://www.buymeacoffee.com/kiwsan"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="/images/buy-me-a-coffee.png"
          alt="Buy Me a Coffee - support this site"
          width="545"
          height="153"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
    <div class="footer-content">
      <p>&copy; {new Date().getFullYear()} Ekkachai Kiwsanthia. All rights reserved.</p>
      <p class="build-version">build version: {buildVersion}</p>
      <div class="footer-links">
        <a href={SITE.github} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
        <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn
        </a>
        <a href={`mailto:${SITE.email}`}>Email</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-8) 0;
    background: var(--color-page);
    color: var(--color-ink);
    border-top: 1px solid var(--color-rule);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-rule);
  }

  .footer-content p {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .build-version {
    font-size: var(--text-small) !important;
    color: var(--color-ink-muted);
  }

  .footer-links {
    display: flex;
    gap: var(--space-6);
  }

  .footer-links a {
    font-size: var(--text-small);
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .footer-links a:hover {
    color: var(--color-signal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .footer-links a:active {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.1em;
  }

  .footer-referrals {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-rule);
  }

  .footer-referrals p {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
    width: 100%;
    margin: 0;
  }

  .footer-referrals p:not(:first-child) {
    margin-top: var(--space-2);
  }

  .footer-referrals a {
    display: inline-flex;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    text-decoration: none;
  }

  .footer-referrals a:hover,
  .footer-referrals a:active {
    padding-bottom: 1px;
    border-bottom: 2px solid var(--color-signal);
  }

  .footer-referrals img {
    width: auto;
    height: 40px;
  }

  .footer-referrals .bmc-button img {
    height: 34px;
    max-width: 100%;
  }

  @media (min-width: 769px) {
    /* Keep the last row clear of the fixed 56px chat control at the right. */
    .footer-content {
      padding-right: calc(56px + var(--space-6));
    }
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
      gap: var(--space-3);
    }
    .footer-referrals {
      justify-content: center;
      text-align: center;
      gap: var(--space-3);
    }
    .footer-links {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .footer {
      /* Keep the links clear of the fixed chat button in the bottom corner. */
      padding: var(--space-6) 0 calc(var(--space-6) + 3rem);
    }
    .footer-links {
      gap: var(--space-4);
    }
  }
</style>
