---
interface Props {
  basePath?: string;
}

const { basePath = '' } = Astro.props;
---

<header class="header">
  <div class="container">
    <a href="/" class="logo" aria-label="Home">
      <svg
        viewBox="0 0 40 40"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="logo-svg"
        aria-hidden="true"
      >
        <!-- flow lines -->
        <path
          d="M5 28C13 6 27 6 35 28"
          stroke="currentColor"
          stroke-width="3"
          fill="none"
          stroke-linecap="round"
        />

        <path
          d="M5 12C13 34 27 34 35 12"
          stroke="currentColor"
          stroke-width="3"
          fill="none"
          stroke-linecap="round"
        />

        <!-- endpoints -->
        <circle cx="5" cy="28" r="1.2" fill="currentColor" />
        <circle cx="35" cy="28" r="1.2" fill="currentColor" />
        <circle cx="5" cy="12" r="1.2" fill="currentColor" />
        <circle cx="35" cy="12" r="1.2" fill="currentColor" />
      </svg>
    </a>
    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav class="nav" id="nav" aria-label="Main navigation">
      <a href={`${basePath}#experience`}>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
        </svg>
        Experience
      </a>
      <a href={`${basePath}#workforce`}>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="7" r="3" />
          <circle cx="5" cy="17" r="2" />
          <circle cx="19" cy="17" r="2" />
          <path d="M12 10v3M7 15.5l3-1.5M17 15.5l-3-1.5" />
        </svg>
        Workforce
      </a>
      <a href={`${basePath}#projects`}>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
        </svg>
        Projects
      </a>
      <a href={`${basePath}#contact`}>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
          <polyline points="22,6 12,13 2,6" />
        </svg>
        Contact
      </a>
      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
      >
        <svg
          class="icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg
          class="icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--color-page);
    border-bottom: 1px solid var(--color-rule);
  }

  .header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .logo:hover {
    color: var(--color-signal);
  }

  .logo-svg {
    display: block;
    width: 36px;
    height: 36px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .nav a:hover {
    color: var(--color-signal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .nav a:active {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.1em;
  }

  .nav a svg {
    flex-shrink: 0;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-2);
    background: var(--color-page);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-control);
    cursor: pointer;
  }

  .menu-toggle:hover {
    color: var(--color-signal);
  }

  .menu-toggle:active {
    background: var(--color-plate);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
  }

  .menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(6px, -6px);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: var(--color-page);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-control);
    cursor: pointer;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    color: var(--color-signal);
  }

  .theme-toggle:active {
    background: var(--color-plate);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  .theme-toggle .icon-sun {
    display: block;
  }

  :global([data-theme='dark']) .theme-toggle .icon-moon {
    display: block;
  }

  :global([data-theme='dark']) .theme-toggle .icon-sun {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .icon-moon {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle .icon-sun {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .nav {
      position: fixed;
      top: 60px;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-1);
      padding: var(--space-4) var(--space-5);
      background: var(--color-page);
      border-top: 1px solid var(--color-rule);
    }

    .nav.active {
      display: flex;
    }

    .menu-toggle {
      display: flex;
      z-index: 60;
    }

    .nav a {
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-body);
      border-radius: var(--radius-control);
    }

    .theme-toggle {
      align-self: flex-start;
      margin-top: var(--space-3);
      margin-left: var(--space-4);
    }
  }

  @media (max-width: 480px) {
    .header .container {
      padding-top: var(--space-3);
      padding-bottom: var(--space-3);
    }

    .logo-svg {
      width: 32px;
      height: 32px;
    }

    .nav {
      top: 52px;
    }

    .theme-toggle {
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('nav');

  const setMenu = (open: boolean) => {
    menuToggle?.classList.toggle('active', open);
    nav?.classList.toggle('active', open);
    menuToggle?.setAttribute('aria-expanded', String(open));
    menuToggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  menuToggle?.addEventListener('click', () => {
    setMenu(!nav?.classList.contains('active'));
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>
