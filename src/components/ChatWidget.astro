---
---

<!-- Chat Tooltip -->
<div class="chat-tooltip" id="chat-tooltip" aria-hidden="true">
  Ask me anything!
</div>

<!-- Chat Toggle Button -->
<button
  class="chat-toggle"
  id="chat-toggle"
  aria-label="Open chat"
  aria-expanded="false"
  aria-controls="chat-window"
  title="Chat with the portfolio assistant"
>
  <svg
    class="chat-icon-open"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
  </svg>
  <svg
    class="chat-icon-close"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <line x1="18" y1="6" x2="6" y2="18" />
    <line x1="6" y1="6" x2="18" y2="18" />
  </svg>
</button>

<!-- Chat Window -->
<div
  class="chat-window"
  id="chat-window"
  role="dialog"
  aria-modal="true"
  aria-labelledby="chat-title"
  aria-hidden="true"
>
  <div class="chat-header">
    <span class="chat-header-title" id="chat-title">
      Ask about Ekkachai
    </span>
    <button class="chat-close" id="chat-close" aria-label="Close chat">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>
  <div
    class="chat-messages"
    id="chat-messages"
    role="log"
    aria-live="polite"
    aria-relevant="additions"
  ></div>
  <div class="chat-input-area">
    <label class="sr-only" for="chat-input">
      Message
    </label>
    <input
      type="text"
      class="chat-input"
      id="chat-input"
      placeholder="Type a message..."
      autocomplete="off"
    />
    <button class="chat-send" id="chat-send" aria-label="Send message">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="22" y1="2" x2="11" y2="13" />
        <polygon points="22 2 15 22 11 13 2 9 22 2" />
      </svg>
    </button>
  </div>
</div>

<style>
  .chat-tooltip {
    position: fixed;
    bottom: 5rem;
    right: 1.5rem;
    z-index: 1001;
    padding: var(--space-2) var(--space-3);
    background: var(--color-plate);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-control);
    font-size: var(--text-small);
    font-family: var(--font-body);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
  }

  .chat-tooltip.show {
    opacity: 1;
  }

  @media (max-width: 480px) {
    .chat-tooltip {
      bottom: 4.5rem;
      right: 1rem;
    }
  }

  .chat-toggle {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 1001;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    padding: 0;
    background: var(--color-ink);
    color: var(--color-page);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-control);
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out);
  }

  .chat-toggle:hover {
    background: var(--color-page);
    color: var(--color-ink);
  }

  .chat-toggle:active {
    background: var(--color-page);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  .chat-toggle .chat-icon-close {
    display: none;
  }

  .chat-toggle.active .chat-icon-open {
    display: none;
  }

  .chat-toggle.active .chat-icon-close {
    display: block;
  }

  @media (max-width: 480px) {
    .chat-toggle {
      bottom: 1rem;
      right: 1rem;
      width: 48px;
      height: 48px;
      min-width: 48px;
      min-height: 48px;
    }
  }

  @media (max-width: 360px) {
    .chat-toggle {
      bottom: 0.75rem;
      right: 0.75rem;
    }
  }

  /* Chat Window */
  .chat-window {
    position: fixed;
    bottom: 6rem;
    right: 1.5rem;
    z-index: 1001;
    display: none;
    flex-direction: column;
    width: 380px;
    height: 520px;
    overflow: hidden;
    background: var(--color-plate);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-surface);
    /* E1: the only elevation in the system. */
    box-shadow: 0 8px 32px color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  .chat-window.open {
    display: flex;
  }

  @media (max-width: 480px) {
    .chat-window {
      bottom: 0;
      right: 0;
      width: 100%;
      height: 100%;
      border: 0;
      border-radius: 0;
    }
  }

  /* Header */
  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background: var(--color-page);
    border-bottom: 1px solid var(--color-rule);
    flex-shrink: 0;
  }

  .chat-header-title {
    font-size: var(--text-small);
    font-weight: 600;
  }

  .chat-close {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-1);
    background: var(--color-page);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-control);
    cursor: pointer;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .chat-close:hover {
    color: var(--color-signal);
  }

  .chat-close:active {
    background: var(--color-plate);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  /* Messages */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .chat-messages::-webkit-scrollbar {
    width: 4px;
  }

  .chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }

  .chat-messages::-webkit-scrollbar-thumb {
    background: var(--color-rule);
    border-radius: var(--radius-control);
  }

  /* Message bubbles */
  :global(.chat-msg) {
    display: flex;
    gap: var(--space-2);
    max-width: 85%;
  }

  :global(.chat-msg.bot) {
    align-self: flex-start;
  }

  :global(.chat-msg.user) {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  :global(.chat-avatar) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--color-ink);
    color: var(--color-page);
    border-radius: var(--radius-control);
    font-size: var(--text-small);
    font-weight: 600;
    flex-shrink: 0;
  }

  :global(.chat-bubble) {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-control);
    font-size: var(--text-small);
    line-height: 1.5;
    word-break: break-word;
  }

  :global(.chat-msg.bot .chat-bubble) {
    background: var(--color-page);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
  }

  :global(.chat-msg.user .chat-bubble) {
    background: var(--color-ink);
    color: var(--color-page);
  }

  :global(.chat-timestamp) {
    margin-top: var(--space-1);
    padding: 0 var(--space-1);
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  :global(.chat-msg.user .chat-timestamp) {
    text-align: right;
  }

  /* Typing indicator: a loading state, not decoration (contract E4). */
  :global(.chat-typing) {
    display: flex;
    gap: 4px;
    padding: var(--space-2) var(--space-3);
    align-items: center;
  }

  :global(.chat-typing-dot) {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-control);
    background: var(--color-ink-muted);
    animation: typingBounce 1.4s infinite ease-in-out;
  }

  :global(.chat-typing-dot:nth-child(2)) {
    animation-delay: 0.2s;
  }

  :global(.chat-typing-dot:nth-child(3)) {
    animation-delay: 0.4s;
  }

  @keyframes typingBounce {
    0%,
    60%,
    100% {
      transform: translateY(0);
    }
    30% {
      transform: translateY(-6px);
    }
  }

  /* Input area */
  .chat-input-area {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-page);
    border-top: 1px solid var(--color-rule);
    flex-shrink: 0;
  }

  .chat-input {
    flex: 1;
    padding: var(--space-2) var(--space-3);
    background: var(--color-page);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-control);
    font-size: var(--text-small);
    font-family: var(--font-body);
    transition: border-color var(--motion-fast) var(--ease-out);
  }

  .chat-input::placeholder {
    color: var(--color-ink-muted);
  }

  .chat-input:hover {
    border-color: var(--color-ink-muted);
  }

  .chat-input:disabled {
    background: var(--color-plate);
    color: var(--color-ink-muted);
  }

  .chat-send {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: var(--color-ink);
    color: var(--color-page);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-control);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out);
  }

  .chat-send:hover {
    background: var(--color-page);
    color: var(--color-ink);
  }

  .chat-send:active {
    background: var(--color-page);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  .chat-send:disabled {
    background: var(--color-plate);
    color: var(--color-ink-muted);
    border-color: var(--color-rule);
    cursor: not-allowed;
  }

  /* Suggestion chips */
  :global(.chat-suggestions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  :global(.chat-suggestion) {
    padding: var(--space-1) var(--space-2);
    background: var(--color-page);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-inline);
    font-size: var(--text-small);
    font-family: var(--font-body);
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out);
  }

  :global(.chat-suggestion:hover) {
    background: var(--color-ink);
    color: var(--color-page);
  }

  :global(.chat-suggestion:active) {
    background: var(--color-ink);
    color: var(--color-page);
    box-shadow: inset 0 0 0 1px var(--color-page);
  }
</style>

<script>
  const chatToggle = document.getElementById('chat-toggle');

  // Show tooltip briefly on all devices
  const tooltip = document.getElementById('chat-tooltip');
  if (tooltip) {
    setTimeout(() => tooltip.classList.add('show'), 2000);
    setTimeout(() => tooltip.classList.remove('show'), 6000);
  }

  function initChat() {
    const chatWindow = document.getElementById('chat-window');
    const chatClose = document.getElementById('chat-close');
    const chatInput = document.getElementById('chat-input') as HTMLInputElement;
    const chatSend = document.getElementById('chat-send') as HTMLButtonElement;
    const chatMessages = document.getElementById('chat-messages');

    let isOpen = false;
    let isBotTyping = false;
    let lastFocused: HTMLElement | null = null;

    const responses: Record<string, string> = {
      skills:
        'Ekkachai is proficient in React, TypeScript, JavaScript, Python, Node.js, and AWS. He also works with Docker, cloud computing, and modern web development frameworks.',
      experience:
        "Ekkachai is a Full Stack Software Engineer with experience building scalable web applications, cloud architecture, and modern JavaScript frameworks. He's based in Bangkok, Thailand.",
      projects:
        'Ekkachai has worked on various projects involving scalable web applications, cloud-native solutions, and full-stack development. Check out the Projects section on this page for details!',
      contact:
        'You can reach Ekkachai via email at kiwsanthia@gmail.com, connect on LinkedIn at linkedin.com/in/kiwsan, or check out his GitHub at github.com/kiwsan.',
      hello:
        "Hi there! I'm Ekkachai's portfolio assistant. I can give quick answers about his skills, work experience, projects, or how to get in touch. What would you like to know?",
    };

    const defaultResponse =
      'I can help you learn about Ekkachai! Try asking about his skills, experience, projects, or contact information.';

    function getTimeString() {
      return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function createMessageEl(text: string, sender: 'bot' | 'user') {
      const msg = document.createElement('div');
      msg.className = `chat-msg ${sender}`;
      if (sender === 'bot') {
        const avatar = document.createElement('div');
        avatar.className = 'chat-avatar';
        avatar.textContent = 'E';
        msg.appendChild(avatar);
      }
      const content = document.createElement('div');
      const bubble = document.createElement('div');
      bubble.className = 'chat-bubble';
      bubble.textContent = text;
      content.appendChild(bubble);
      const timestamp = document.createElement('div');
      timestamp.className = 'chat-timestamp';
      timestamp.textContent = getTimeString();
      content.appendChild(timestamp);
      msg.appendChild(content);
      return msg;
    }

    function createTypingEl() {
      const msg = document.createElement('div');
      msg.className = 'chat-msg bot';
      msg.id = 'chat-typing';
      const avatar = document.createElement('div');
      avatar.className = 'chat-avatar';
      avatar.textContent = 'E';
      msg.appendChild(avatar);
      const bubble = document.createElement('div');
      bubble.className = 'chat-bubble chat-typing';
      const label = document.createElement('span');
      label.className = 'sr-only';
      label.textContent = 'Assistant is typing';
      bubble.appendChild(label);
      for (let i = 0; i < 3; i++) {
        const dot = document.createElement('span');
        dot.className = 'chat-typing-dot';
        bubble.appendChild(dot);
      }
      msg.appendChild(bubble);
      return msg;
    }

    function addWelcomeMessage() {
      chatMessages?.appendChild(createMessageEl(responses.hello, 'bot'));
      const suggestions = document.createElement('div');
      suggestions.className = 'chat-suggestions';
      ['What are his skills?', 'Work experience', 'Projects', 'Contact info'].forEach((text) => {
        const chip = document.createElement('button');
        chip.className = 'chat-suggestion';
        chip.textContent = text;
        chip.addEventListener('click', () => {
          sendMessage(text);
          suggestions.remove();
        });
        suggestions.appendChild(chip);
      });
      chatMessages?.appendChild(suggestions);
    }

    function getMockResponse(input: string) {
      if (
        /skill|tech|stack|react|typescript|python|node|aws|docker|language|framework/i.test(input)
      )
        return responses.skills;
      if (/experience|work|job|career|background|engineer/i.test(input))
        return responses.experience;
      if (/project|portfolio|build|app|application/i.test(input)) return responses.projects;
      if (/contact|email|linkedin|github|hire|reach|connect/i.test(input)) return responses.contact;
      if (/hi|hello|hey|greet|sup|yo/i.test(input)) return responses.hello;
      return defaultResponse;
    }

    function scrollToBottom() {
      if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function setInputEnabled(enabled: boolean) {
      chatInput.disabled = !enabled;
      chatSend.disabled = !enabled;
    }

    function sendMessage(text: string) {
      if (!text.trim() || isBotTyping) return;
      chatMessages?.appendChild(createMessageEl(text, 'user'));
      chatInput.value = '';
      scrollToBottom();
      isBotTyping = true;
      setInputEnabled(false);
      const typingEl = createTypingEl();
      chatMessages?.appendChild(typingEl);
      scrollToBottom();
      setTimeout(
        () => {
          typingEl.remove();
          chatMessages?.appendChild(createMessageEl(getMockResponse(text), 'bot'));
          scrollToBottom();
          isBotTyping = false;
          setInputEnabled(true);
          chatInput.focus();
        },
        1000 + Math.random() * 1000
      );
    }

    function setToggleState(open: boolean) {
      chatToggle?.classList.toggle('active', open);
      chatToggle?.setAttribute('aria-expanded', String(open));
      chatToggle?.setAttribute('aria-label', open ? 'Close chat' : 'Open chat');
    }

    function toggleChat() {
      isOpen = !isOpen;
      setToggleState(isOpen);
      chatWindow?.classList.toggle('open', isOpen);

      if (isOpen) {
        lastFocused = document.activeElement as HTMLElement;
        if (!chatMessages?.hasChildNodes()) addWelcomeMessage();
        chatWindow?.setAttribute('aria-hidden', 'false');
        chatInput.focus();
      } else {
        if (chatWindow?.contains(document.activeElement)) {
          (lastFocused ?? chatToggle)?.focus();
        }
        chatWindow?.setAttribute('aria-hidden', 'true');
      }
    }

    chatToggle?.addEventListener('click', toggleChat);
    chatClose?.addEventListener('click', toggleChat);
    chatSend?.addEventListener('click', () => sendMessage(chatInput.value));
    chatInput?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage(chatInput.value);
      }
    });

    chatWindow?.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || !isOpen) return;

      const focusable = Array.from(
        chatWindow.querySelectorAll<HTMLElement>(
          'button:not(:disabled), input:not(:disabled), [href], [tabindex]:not([tabindex="-1"])'
        )
      ).filter((element) => element.offsetParent !== null);

      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen) toggleChat();
    });
  }

  // Defer full chat init until user interaction (same behavior on all devices)
  let initialized = false;
  function onFirstInteraction() {
    if (initialized) return;
    initialized = true;
    chatToggle?.removeEventListener('click', onFirstInteraction);
    initChat();
    // Re-trigger the click that caused init
    chatToggle?.click();
  }

  chatToggle?.addEventListener('click', onFirstInteraction);
</script>
